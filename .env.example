# Connexion PostgreSQL du rôle PROPRIÉTAIRE — migrations et seed uniquement.
# Copier en `.env` et renseigner la vraie valeur — jamais commiter `.env` (I9).
DATABASE_URL="postgresql://utilisateur:motdepasse@hote:5432/codiplan?sslmode=require"

# Connexion PostgreSQL du rôle APPLICATIF `codiplan_app` — non propriétaire,
# non superutilisateur, non BYPASSRLS. C'est elle que doit porter le service qui
# exécute l'application : `lib/db/garde-role.ts` refuse la connexion sinon.
# En développement, `DATABASE_URL` peut suffire tant que le contrôle passe.
# APP_DATABASE_URL="postgresql://codiplan_app:motdepasse@hote:5432/codiplan?sslmode=require"

# Connexion PostgreSQL du rôle de CONSOLIDATION `codiplan_reporting` (D21) —
# BYPASSRLS, SELECT seul. Réservée à `lib/reporting`. Absente, la consolidation
# multi-sociétés est refusée ; c'est le comportement voulu par défaut.
REPORTING_DATABASE_URL="postgresql://codiplan_reporting:motdepasse@hote:5432/codiplan?sslmode=require"

# Secret de signature des sessions Better Auth (L0-06). Engendrer une valeur
# aléatoire d'au moins 32 octets, propre à chaque environnement.
BETTER_AUTH_SECRET="a-remplacer-par-un-secret-aleatoire"

# URL publique de l'application, utilisée par Better Auth pour ses redirections.
BETTER_AUTH_URL="http://localhost:3000"

# Base PostgreSQL LOCALE ET JETABLE des tests d'isolation. Jamais la base
# hébergée : un garde-fou du harnais refuse une URL Neon ou identique à
# DATABASE_URL.
TEST_DATABASE_URL="postgresql://postgres@127.0.0.1:5433/codiplan_test"
