{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated",
        "--no-sandbox",
        "--executable-path",
        "${PLAYWRIGHT_MCP_EXECUTABLE_PATH:-/opt/pw-browsers/chromium}",
        "--output-dir",
        "test-results/playwright-mcp"
      ]
    }
  }
}
