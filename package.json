{
  "name": "codiplan",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:isolation": "vitest run --project isolation",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:referentiels": "tsx scripts/referentiels-plateforme.mts",
    "db:societe-initiale": "tsx scripts/societe-initiale.mts",
    "db:deploy": "prisma migrate deploy",
    "db:resoudre": "tsx scripts/resoudre-migration.mts",
    "db:generate": "prisma generate",
    "feries:horizon": "tsx scripts/horizon-feries.mts",
    "feries:etendre": "tsx scripts/etendre-feries.mts",
    "audit:partitions": "tsx scripts/audit-partitions.mts",
    "battement": "tsx scripts/battement-nocturne.mts",
    "veille": "tsx scripts/veille-hebergee.mts",
    "deploiement:verifier": "tsx scripts/verifier-deploiement.mts",
    "file": "tsx scripts/file-de-nuit.mts",
    "db:refus-si-reelles": "tsx scripts/refus-si-donnees-reelles.mts",
    "suspensions:denombrer": "tsx scripts/denombrer-suspensions.mts",
    "partitions:etendre": "tsx scripts/etendre-partitions.mts",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm test:isolation && pnpm build",
    "verify:full": "pnpm verify && pnpm feries:horizon && pnpm audit:partitions && pnpm test:e2e"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.3.3",
    "better-auth": "^1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "15.5.23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "read-excel-file": "^9.3.10",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/utils": "0.4.2",
    "@eslint/eslintrc": "^3.3.3",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.0",
    "eslint-config-next": "15.5.23",
    "jsdom": "^30.0.1",
    "prettier": "^3.6.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@tailwindcss/oxide",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
