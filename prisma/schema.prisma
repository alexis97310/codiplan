// CODIPLAN — Schéma multi-société (ticket L0-03).
//
// Portée stricte du ticket : les sept tables du socle multi-société —
// societe, agence, devise, parite, utilisateur, utilisateur_societe,
// utilisateur_client. Aucune table métier au-delà (client, site, machine,
// intervention… arrivent aux lots suivants).
//
// Sources : cahier des charges chapitre 11, et arbitrages D4, D5, D10, D20.
// Les politiques Row Level Security relèvent du ticket L0-04, pas de celui-ci.
//
// Les identifiants sont typés `uuid` en base (`@db.Uuid`), pas `text` : ils
// SONT des UUID v7 (I10), et la forme de politique imposée par D4 compare
// `societe_id` à `current_setting('app.societe_id')::uuid`. Seul `devise.code`
// reste `text` — c'est un code ISO, pas un identifiant technique.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Énumération canonique des rôles internes (arbitrage — gravité 4, puis D37).
/// Complète dès maintenant même si l'authentification est câblée à L0-06.
/// Le rôle `client` désigne un compte portail : il ne prend jamais de ligne
/// dans `utilisateur_societe` (voir D10), il vit dans `utilisateur_client`.
///
/// `admin_societe` est le dixième rôle, ajouté par D37 : l'énumération avait été
/// fermée avant l'arbitrage « il faut prévoir de vendre la solution », et il y
/// manquait donc un administrateur AU NIVEAU SOCIÉTÉ. Sans lui, créer un compte
/// chez un client passerait par l'éditeur — intenable dès la première vente.
/// Il est déclaré entre les rôles éditeur et `direction` : c'est la frontière
/// entre ce qui est au-dessus des sociétés et ce qui est dedans.
enum Role {
  admin_plateforme
  editeur_commercial
  editeur_support
  admin_societe
  direction
  responsable_materiel
  responsable_sav
  adv
  technicien
  client
}

/// Référentiel de plateforme (I1 — liste close). Pas de `societe_id` :
/// le franc Pacifique est le même partout, la table est lisible par toutes
/// les sociétés. La parité datée vit dans `parite` (D20), plus dans `devise`.
model Devise {
  interventions Intervention[]

  code          String        @id
  libelle       String
  decimales     Int
  symbole       String? // symbole si la devise en a un, sinon on affiche le code (D19)
  societes      Societe[]
  parites       Parite[]
  taux_horaires TauxHoraire[]
  forfaits      Forfait[]

  @@map("devise")
}

/// Référentiel de plateforme (I1 — liste close, D41). Pas de `societe_id` :
/// la parité légale du franc Pacifique est la même pour tout le monde, comme
/// la devise elle-même. Elle manquait à la liste close de D4, arrêtée AVANT que
/// D20 ne crée cette table — le gardien d'exhaustivité
/// `tests/unit/db/categories-i1.test.ts` empêche désormais qu'un tel oubli
/// puisse durer plus longtemps que le commit qui crée la table.
///
/// Parités datées pour la consolidation multi-devise (D20). Remplace
/// `devise.parite_reference` / `parite_date`. Réservée à `lib/reporting`,
/// jamais de conversion ligne à ligne (I2). Amorcée avec la seule parité
/// légale fixe du franc Pacifique (1 EUR = 119,331740 XPF) : le taux, porté
/// par la ligne XPF, se lit « XPF pour 1 EUR » (base EUR) — voir
/// docs/decisions/2026-08-20-parite-xpf-fixe.md. Toute autre parité (taux de
/// marché) reste arrêtée au lot reporting.
model Parite {
  id          String   @id @db.Uuid
  devise_code String
  date_effet  DateTime @db.Date
  taux        Decimal  @db.Decimal(18, 8)
  source      String
  devise      Devise   @relation(fields: [devise_code], references: [code])

  @@unique([devise_code, date_effet])
  @@map("parite")
}

/// Table racine (chapitre 11 §11.2). Une société porte sa devise, sa charte,
/// son taux horaire, son fuseau. Toutes les tables cloisonnées la référencent.
model Societe {
  techniciens Technicien[]
  absences    Absence[]
  segments    SegmentTravail[]

  trajets_par_zone TempsTrajetZone[]

  intervention_machines InterventionMachine[]

  demandes Demande[]

  technicien_calendriers TechnicienCalendrier[]

  interventions Intervention[]

  documents       Document[]
  documents_recus DocumentRecu[]

  import_lots       ImportLot[]
  import_lot_lignes ImportLotLigne[]

  id                            String  @id @db.Uuid
  code                          String  @unique // préfixe de numérotation
  raison_sociale                String
  pays                          String
  territoire                    String
  fuseau_horaire                String // ex. Pacific/Noumea
  devise_code                   String
  majoration_hors_ouverture_pct Decimal @db.Decimal(5, 2)
  /// Libellé d'affichage de `client.code_externe` — « Code Winpro » chez
  /// CODIMA, autre chose ailleurs (D29, chapitre 11.2). NULLABLE et sans
  /// valeur par défaut : nommer un défaut reviendrait à réintroduire dans le
  /// produit le vocabulaire de l'ERP d'un seul client, ce que D29 corrige.
  /// Absent, l'interface affiche le libellé générique du dictionnaire.
  libelle_code_externe          String?
  /// Logo de la société. HORS PÉRIMÈTRE de L0-09 : l'afficher suppose un
  /// stockage de fichiers, décision d'architecture inscrite au registre des
  /// arbitrages. La colonne existe depuis L0-03 et le mécanisme de
  /// thématisation ne l'empêche pas — il la lira le jour venu.
  logo_url                      String?
  /// Charte de la société (L0-09) — couleur d'identité et couleur
  /// d'accentuation, des DONNÉES et jamais des constantes de compilation : un
  /// client change ses couleurs sans qu'on redéploie.
  ///
  /// **Nullables depuis L0-09**, et c'est le point : « société sans charte »
  /// doit être un état représentable. Sinon le provisionnement d'un nouveau
  /// client inventerait deux couleurs pour satisfaire la contrainte, et
  /// personne ne saurait ensuite distinguer un choix d'un remplissage. Une
  /// société sans charte reçoit le thème neutre CODIPLAN (lib/theme/defaut.ts).
  ///
  /// Une contrainte `CHECK` refuse en base ce qui n'est pas une couleur sRGB
  /// (`#rgb` ou `#rrggbb`). C'est le SEUL refus de couleur du dépôt, et il
  /// porte sur la forme, jamais sur la teinte : la lisibilité, elle, se calcule
  /// au rendu (D51, lib/theme/contraste.ts).
  couleur_primaire              String?
  couleur_secondaire            String?
  mentions_legales              String? // pied des documents
  langue                        String // documente une intention, non exploitée en V1 (D26)
  actif                         Boolean @default(true)

  devise                  Devise                    @relation(fields: [devise_code], references: [code])
  agences                 Agence[]
  calendriers             Calendrier[]
  utilisateur_societes    UtilisateurSociete[]
  utilisateur_clients     UtilisateurClient[]
  perimetres_portail      UtilisateurClientSite[]
  contacts                Contact[]
  habilitations           Habilitation[]
  techniciens_habilites   TechnicienHabilitation[]
  sites_habilitations     SiteHabilitationRequise[]
  clients                 Client[]
  sessions_actives        Session[]
  sites                   Site[]
  familles_materiel       FamilleMateriel[]
  modeles_materiel        ModeleMateriel[]
  taux_horaires           TauxHoraire[]
  forfaits                Forfait[]
  machines                Machine[]
  prestations             Prestation[]
  verifications_vgp       VgpVerification[]
  observations_vgp        VgpObservation[]
  campagnes_vgp           VgpCampagne[]
  interventionPrestations InterventionPrestation[]
  interventionSignatures  InterventionSignature[]
  interventionPauses      InterventionPause[]

  @@map("societe")
}

/// Établissement CODIMA — Ducos, Koné, Dolbeau (D5). À ne jamais confondre
/// avec un « site », qui est un lieu d'intervention chez un client.
model Agence {
  techniciens Technicien[]

  demandes Demande[]

  interventions Intervention[]

  id             String  @id @db.Uuid
  societe_id     String  @db.Uuid
  code           String // DUCOS, KONE, DOLBEAU
  libelle        String
  adresse        Json?
  /// Fuseau IANA — `Pacific/Noumea`, `Europe/Paris`. Hérité de la société,
  /// surchargeable (D5). Dit QUELLE HEURE il est.
  fuseau_horaire String?
  /// Territoire au sens des JOURS FÉRIÉS, en code ISO 3166-1 alpha-2 — `NC`,
  /// `FR`. Clé de `jour_ferie` (D46). Dit QUELS JOURS SONT FÉRIÉS.
  ///
  /// **Indépendant du fuseau, et jamais déduit de lui** (D46, complément 1).
  /// `Europe/Paris` couvre plusieurs territoires aux fériés différents ; deux
  /// agences peuvent partager une heure et pas un calendrier de fêtes. Le
  /// gardien `tests/unit/calendar/territoire-independant-du-fuseau.test.ts`
  /// refuse toute dérivation de l'un vers l'autre.
  ///
  /// À ne pas confondre non plus avec `societe.territoire`, qui porte une
  /// circonscription administrative (« Province Sud ») sans rapport avec les
  /// fériés.
  ///
  /// **OBLIGATOIRE depuis L0-09a (D48).** La colonne a été posée nullable à
  /// L0-08, faute de défaut légitime — un `DEFAULT 'NC'` aurait été un
  /// territoire codé en dur. Elle devient obligatoire au moment où une
  /// contrainte s'appuie dessus : le chaînage de `calendrier_ferie` passe par
  /// `(agence_id, territoire)`, et une clé étrangère dont une colonne vaut
  /// NULL n'est pas contrôlée en PostgreSQL. Nullable, le verrou serait muet
  /// exactement là où la donnée manque.
  territoire     String
  calendrier_id  String? @db.Uuid // calendrier d'ouverture — table posée au ticket L0-08
  actif          Boolean @default(true)

  societe    Societe           @relation(fields: [societe_id], references: [id])
  calendrier Calendrier?       @relation(fields: [calendrier_id], references: [id])
  ecarts     CalendrierFerie[]
  sites      Site[]

  @@unique([societe_id, code])
  /// Clé composite technique — cible du chaînage de `site` (L1-02, D56). `id`
  /// étant déjà la clé primaire, elle n'ajoute aucune unicité : elle rend le
  /// couple (société, agence) référençable d'un seul geste, de sorte qu'un site
  /// ne puisse pas se rattacher à l'agence d'une AUTRE société.
  @@unique([societe_id, id])
  /// Clé composite technique — cible du chaînage de `calendrier_ferie` (D48).
  /// `id` étant déjà la clé primaire, elle n'ajoute aucune unicité : elle rend
  /// simplement le couple (agence, territoire) référençable d'un seul geste.
  @@unique([id, territoire])
  @@index([territoire])
  @@map("agence")
}

// ── Calendriers d'agence et jours fériés (ticket L0-08, I7, D5, D13, D46) ────
//
// Le fuseau appartient à l'AGENCE — `agence.fuseau_horaire`, surchargeable,
// hérité de la société (D5). Il est stocké au format IANA (`Pacific/Noumea`,
// `Europe/Paris`), jamais sous forme de décalage numérique : un décalage est
// une conséquence du fuseau et de la date, pas une donnée. Nouméa ne change pas
// d'heure, Paris si — un `+11` figé en base serait faux la moitié de l'année.
//
// Tout instant est en `timestamptz`. Aucune table ci-dessous n'en porte : elles
// portent des RÈGLES LOCALES (jour de semaine, minutes depuis minuit) et des
// JOURS (date sans heure), qui n'ont pas de fuseau propre — c'est le calendrier
// qui leur en donne un à la lecture. Une récurrence figée en instants UTC se
// décalerait d'une heure deux fois par an à Paris (point 3 du ticket L0-08).

/// Référentiel de plateforme (I1 — liste close, D46). PAS de `societe_id` :
/// le 14 juillet est un fait du TERRITOIRE, identique pour toutes les sociétés
/// qui y opèrent, exactement comme la parité légale du franc Pacifique (D41).
/// La Nouvelle-Calédonie a ses fériés, la métropole les siens, et un client sur
/// un autre territoire aura les siens — d'où la clé `(territoire, date)`.
///
/// **Cette table dit ce qui EST férié, jamais ce qui est chômé.** Un férié peut
/// être travaillé (RG-PLA-02) : ce choix relève de l'agence et vit dans
/// `calendrier_ferie`, qui est cloisonnée. La séparation est celle de D13 —
/// « les jours fériés sont portés par le calendrier », le référentiel n'en
/// fournit que les dates.
///
/// Alimentée par le seed (point 4 du ticket) : aucune date fériée n'est écrite
/// dans le code, et le gardien
/// `tests/unit/calendar/sans-date-feriee-en-dur.test.ts` le vérifie. Les fêtes
/// mobiles adossées à Pâques sont CALCULÉES par `lib/calendar/paques.ts`, mais
/// le calcul produit ces lignes ; il ne s'exécute jamais dans le métier.
model JourFerie {
  id         String   @id @db.Uuid
  /// Territoire au sens des fériés, en code ISO 3166-1 alpha-2 — `NC`, `FR`.
  /// Jamais la province administrative de `societe.territoire`, jamais un
  /// fuseau : un territoire et un fuseau sont deux attributs indépendants de
  /// l'agence (D46, complément 1).
  territoire String
  /// Jour, sans heure : un férié n'est pas un instant.
  date       DateTime @db.Date
  libelle    String
  /// Vrai pour les fêtes adossées à Pâques — trace l'origine de la ligne.
  mobile     Boolean  @default(false)

  ecarts CalendrierFerie[]

  @@unique([territoire, date])
  /// Clé composite technique : elle permet à `calendrier_ferie` de référencer
  /// le triplet (jour férié, date, territoire) d'un seul geste, si bien que ni
  /// sa colonne `date` ni sa colonne `territoire` ne peuvent diverger du fait
  /// public qu'il surcharge. Élargie du couple `(id, date)` au triplet en
  /// L0-09a : la date ne divergeait plus, le territoire le pouvait encore
  /// (D48).
  @@unique([id, date, territoire])
  @@index([territoire])
  @@map("jour_ferie")
}

/// Calendrier d'ouverture d'une AGENCE (D5) — table métier, `societe_id NOT
/// NULL`. À ne jamais confondre avec les horaires d'un SITE client, qui ne
/// produisent qu'un avertissement (D13).
///
/// Plusieurs agences peuvent partager un calendrier : c'est la forme que prend
/// « héritage depuis la société avec surcharge possible par agence » (D13) —
/// la société pose un calendrier par défaut, l'agence qui en diffère reçoit le
/// sien. Aucun calendrier global codé en dur (I7) : Ducos ouvre du lundi au
/// samedi, Koné du lundi au vendredi, et rien dans le code ne le sait.
model Calendrier {
  id         String  @id @db.Uuid
  societe_id String  @db.Uuid
  code       String
  libelle    String
  actif      Boolean @default(true)

  /// LE PAS DE CRÉNEAU, en minutes locales — ce que le planning propose comme
  /// grille (lot 2). Une valeur PAR CALENDRIER, donc par agence : Ducos ouvre
  /// du lundi au samedi et Koné du lundi au vendredi (I7), et rien ne dit
  /// qu'elles découpent leur journée pareil.
  ///
  /// **La valeur par défaut n'est pas une règle métier** : 30 minutes est une
  /// valeur d'AMORÇAGE que l'exploitation change à l'écran de réglage. Elle est
  /// écrite ici plutôt que dans un composant, parce qu'une valeur en dur dans
  /// un composant n'est réglable par personne.
  pas_creneau_minutes Int @default(30)

  societe     Societe                @relation(fields: [societe_id], references: [id])
  agences     Agence[]
  plages      CalendrierPlage[]
  techniciens TechnicienCalendrier[]

  @@unique([societe_id, code])
  @@map("calendrier")
}

/// L'EXCEPTION D'HORAIRES PAR TECHNICIEN (lot 2).
///
/// Un technicien à temps partiel, un apprenti en alternance, un renfort qui ne
/// vient que le matin : leur disponibilité n'est pas celle de leur agence, et
/// I7 interdit tout calendrier global codé en dur — la même raison vaut un
/// cran plus bas.
///
/// **C'est un RATTACHEMENT, pas une copie d'horaires.** Le technicien reçoit un
/// AUTRE calendrier de la même société, avec ses propres plages ; il n'a pas
/// des plages à lui, écrites à côté de celles d'un calendrier. Recopier les
/// plages aurait fait deux lectures d'un même critère (§9, 01/09), et la
/// seconde aurait cessé d'être vraie au premier changement d'horaires.
///
/// **Ce que cette table NE dit PAS : elle ne majore rien.** Une exception
/// d'horaires dit quand le technicien travaille, jamais à quel prix — la
/// majoration relève de RG-TAR et de l'agence du technicien (I7), et l'y mêler
/// ferait payer au client la souplesse d'un contrat de travail.
/// LE TECHNICIEN — l'agence de rattachement, et rien de plus (L3-01a).
///
/// Le chapitre 11 décrit *« technicien — utilisateur, société, agence, coût
/// horaire, taux de facturation par défaut, véhicule, actif »*. **Trois de ces
/// colonnes ne sont PAS créées**, et chacune pour une raison écrite :
///
/// - **`cout_horaire` et `taux_facturation_defaut`** — *c'est exactement le
///   piège de `societe.taux_horaire_defaut`, RETIRÉE le 09/09/2026* : deux
///   sources d'un même fait qui divergent en valeur. Le taux vit dans
///   `taux_horaire`, **historisé par date d'effet** (RG-TAR-04), et *une facture
///   qui change quand le tarif change est une facture fausse*. Un défaut par
///   technicien rouvrirait la même porte.
/// - **`vehicule`** — rien ne le lit, rien ne l'écrit. *Une colonne inerte n'est
///   pas neutre, elle est une invitation* : elle s'implémentera un jour de
///   travers, par quelqu'un qui la trouvera au schéma et lui cherchera un sens
///   (le motif de D77).
///
/// **Et le calendrier propre n'est PAS ici** : `technicien_calendrier` le porte
/// déjà, sur la clé `(societe_id, utilisateur_id)`. L'ajouter ferait deux
/// écritures d'un même fait (§9, 01/09).
///
/// Ce qui reste est ce que L3-01 réclame nommément — *« la table `technicien`
/// (utilisateur, société, **agence**, actif), à créer au lot 3 avant
/// l'écran »* — et ce dont D12 et D13 ont besoin depuis le lot 2 : **l'agence
/// DU TECHNICIEN**, qui décide de la majoration hors ouverture et du calendrier
/// de détection de conflit.
model Technicien {
  /// **Exigée par le journal d'audit, et ce n'est pas une formalité** :
  /// `journal_audit_tracer` désigne la ligne journalisée par sa clé technique
  /// (I10) et LÈVE si la table n'expose aucune colonne `id`. Sa voisine
  /// `technicien_calendrier` ne l'avait pas — *et elle était donc impossible à
  /// écrire, sans que rien ne le dise, parce que rien ne l'écrivait* (mesuré à
  /// L3-01a).
  ///
  /// La clé PRIMAIRE reste le couple : c'est lui qui dit « une personne, une
  /// société, un rattachement ».
  id String @db.Uuid

  societe_id     String @db.Uuid
  utilisateur_id String @db.Uuid

  /// L'AGENCE DE RATTACHEMENT. C'est elle — et non celle de l'intervention —
  /// qui décide de la majoration hors ouverture (D12) et du calendrier de
  /// détection de conflit à la pose (D13).
  agence_id String @db.Uuid

  /// Un technicien qui a quitté l'entreprise ne se supprime pas : ses
  /// interventions passées le nomment encore. *Il cesse d'être proposé, il ne
  /// cesse pas d'avoir existé.*
  actif Boolean @default(true)

  cree_le    DateTime @default(now())
  modifie_le DateTime @updatedAt

  societe Societe @relation(fields: [societe_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  agence  Agence  @relation(fields: [societe_id, agence_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)

  /// La MÊME clé que `technicien_calendrier` : un technicien est une PERSONNE
  /// dans une SOCIÉTÉ, et son identité vit dans `utilisateur` — qui ne porte
  /// aucune donnée métier (I1, quatrième catégorie).
  @@id([societe_id, utilisateur_id])
  @@unique([id])
  @@index([societe_id, agence_id])
  @@map("technicien")
}

model TechnicienCalendrier {
  /// AJOUTÉE À L3-01a, et la table était INÉCRIVABLE sans elle.
  ///
  /// `journal_audit_tracer` lève quand la table n'expose aucune colonne `id` ;
  /// le déclencheur était posé ici depuis le paramétrage par agence, et
  /// **aucun INSERT n'a jamais abouti**. Personne ne l'avait vu parce que
  /// personne n'écrivait : *un défaut invisible parce que ce qu'il casse
  /// n'existe pas encore* (§9, 08/09). Mesuré par un `INSERT` direct.
  id String @db.Uuid

  societe_id     String @db.Uuid
  utilisateur_id String @db.Uuid
  calendrier_id  String @db.Uuid

  cree_le    DateTime @default(now())
  modifie_le DateTime @updatedAt

  societe    Societe    @relation(fields: [societe_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  calendrier Calendrier @relation(fields: [calendrier_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([societe_id, utilisateur_id])
  @@unique([id])
  @@index([societe_id, calendrier_id])
  @@map("technicien_calendrier")
}

/// Une plage d'ouverture hebdomadaire — table métier, `societe_id NOT NULL`.
///
/// C'est une RÉCURRENCE stockée sous sa forme locale : un jour de semaine ISO
/// et des minutes depuis minuit, jamais des instants UTC (point 3 du ticket).
/// Le fuseau lui vient de l'agence à la lecture, si bien qu'« ouverture à 8 h »
/// reste 8 h des deux côtés d'un changement d'heure.
///
/// Plusieurs plages par jour sont admises : la coupure de midi en est une. Un
/// jour sans aucune plage est un jour fermé — il n'y a pas de booléen `ouvert`,
/// qui pourrait contredire les plages.
model CalendrierPlage {
  id            String @id @db.Uuid
  societe_id    String @db.Uuid
  calendrier_id String @db.Uuid
  /// Jour ISO 8601 — 1 lundi, 7 dimanche. La semaine commence le lundi.
  jour_semaine  Int
  /// Ouverture, en minutes locales depuis minuit. 8 h = 480.
  debut_minutes Int
  /// Fermeture, en minutes locales depuis minuit. Minuit = 1440.
  fin_minutes   Int

  calendrier Calendrier @relation(fields: [calendrier_id], references: [id], onDelete: Cascade)

  @@unique([calendrier_id, jour_semaine, debut_minutes])
  @@index([calendrier_id])
  @@map("calendrier_plage")
}

/// **L'ÉCART LOCAL** — ce par quoi une AGENCE s'écarte du fait public
/// (D46, compléments 1 et 2). Table métier : `societe_id NOT NULL`, et
/// `agence_id NOT NULL`.
///
/// **L'ordre de lecture, et il ne s'inverse jamais.**
///   1. `jour_ferie` porte le **fait public du territoire** — ce qui EST férié.
///   2. `calendrier_ferie` porte **l'écart local** — ce que l'agence en fait.
/// Le fait public d'abord, l'écart local ensuite. Lire dans l'autre sens
/// donnerait à une agence le pouvoir de décréter un férié pour son territoire,
/// ce qui n'appartient à aucune entreprise. `appliquerEcarts` dans
/// `lib/calendar/calendrier.ts` tient cet ordre, et un test le prouve.
///
/// **Pourquoi `agence_id` et non `calendrier_id`**, alors que la table porte le
/// mot « calendrier » : plusieurs agences partagent un calendrier d'ouverture
/// (D13), mais un pont ou un férié travaillé est la décision d'UNE agence.
/// Ducos et Dolbeau ouvrent aux mêmes heures et peuvent parfaitement diverger
/// sur le pont du 25 septembre.
///
/// **Deux écarts, une seule table.**
///   — `jour_ferie_id` renseigné, `travaille = true` : l'agence TRAVAILLE ce
///     férié (RG-PLA-02 — « un férié n'est pas systématiquement chômé »).
///   — `jour_ferie_id` nul, `travaille = false` : un **pont** propre à
///     l'entreprise, un jour ordinaire que l'agence chôme.
/// Les deux combinaisons restantes sont licites et redondantes : elles répètent
/// ce que le fait public ou les plages disent déjà.
///
/// **L'écart ne crée pas d'horaires**, il autorise ou retire ceux du jour de
/// semaine. `travaille = true` un dimanche où aucune plage n'est déclarée
/// n'ouvre rien — et c'est ce qu'on veut : les horaires vivent dans
/// `calendrier_plage`, à un seul endroit.
///
/// **LE CHAÎNAGE DE CLÉS (D48).** Un écart ne peut s'adosser qu'à un férié du
/// territoire de son agence. Deux clés étrangères composites l'imposent, et
/// c'est PostgreSQL qui refuse — aucun chemin d'écriture n'y échappe :
///   — `(agence_id, territoire)` → `agence(id, territoire)` ;
///   — `(jour_ferie_id, date, territoire)` → `jour_ferie(id, date, territoire)`.
/// Le pont reste possible : `jour_ferie_id` nul rend la seconde clé non
/// contrôlée (`MATCH SIMPLE`, la règle par défaut de PostgreSQL), tandis que la
/// première, dont aucune colonne n'est nullable, reste contrôlée toujours.
///
/// **AUCUNE PROPAGATION** (D49) : `onUpdate: Restrict` des deux côtés. Changer
/// le territoire d'une agence est REFUSÉ tant qu'il lui reste un écart — un
/// changement de territoire les invalide réellement, puisqu'ils désignent les
/// fériés d'ailleurs. `Cascade` avait été essayé : sur une agence dont les
/// écarts sont tous des ponts, il réécrivait leurs territoires en silence. Le
/// déclencheur `agence_territoire_verrou_ecarts` double le refus d'un message
/// qui dit quoi faire ; il ne le remplace pas.
///
/// **UN SEUL DES DEUX REFUS A UNE VOIX, ET C'EST DÉLIBÉRÉ** (D50). Le refus
/// côté `agence` a son déclencheur explicatif ; celui côté `jour_ferie` n'en a
/// pas. **Ce n'est pas un oubli à corriger, et la correction irait dans la
/// direction dangereuse.** L'écrivain de `jour_ferie` est un rôle éditeur, qui
/// par construction n'a aucune société active : un déclencheur `SECURITY
/// INVOKER` n'y verrait aucun écart — mesuré, 0 contre 1 — parce que
/// `calendrier_ferie` est cloisonnée en `FORCE ROW LEVEL SECURITY`, alors que
/// les contrôles d'intégrité référentielle, eux, s'exécutent hors RLS. Lui
/// donner la vue qui lui manque ferait d'un message d'erreur un lecteur
/// inter-sociétés : un décompte apprendrait à un salarié de l'éditeur combien
/// d'agences clientes chôment ce jour-là. Le message viendra de la console
/// éditeur au lot 7 (ticket L7-02), et il dira que des écarts existent — jamais
/// combien, jamais lesquels. `tests/unit/db/security-definer-sous-arbitrage.test.ts`
/// échoue si quelqu'un tente le raccourci.
model CalendrierFerie {
  id            String   @id @db.Uuid
  societe_id    String   @db.Uuid
  agence_id     String   @db.Uuid
  /// Jour concerné, local. Présent même quand `jour_ferie_id` l'est aussi : un
  /// pont n'a pas de fait public à désigner. La clé étrangère composite
  /// ci-dessous empêche les deux dates de diverger.
  date          DateTime @db.Date
  /// Territoire de l'agence, RECOPIÉ ici (D48). C'est une redondance, et elle
  /// est assumée : elle n'existe que pour rendre le chaînage DÉCLARATIF. Sans
  /// colonne portée par la ligne, aucune clé étrangère ne peut relier en un
  /// seul geste l'agence et le fait public, et la règle retomberait dans un
  /// contrôle applicatif — c'est-à-dire dans un chemin d'écriture qu'on peut
  /// oublier. Elle n'est jamais saisie : elle vient de l'agence, et les deux
  /// clés étrangères la tiennent des deux côtés à la fois.
  territoire    String
  /// Le fait public dont c'est l'écart, s'il y en a un. Nul pour un pont.
  jour_ferie_id String?  @db.Uuid
  /// L'agence travaille-t-elle ce jour-là ? Sans valeur par défaut : une ligne
  /// d'écart qui ne dirait pas ce qu'elle décide n'aurait aucun sens.
  travaille     Boolean
  /// Motif libre — « pont de l'Ascension », « journée de solidarité ».
  motif         String?

  agence     Agence     @relation(fields: [agence_id, territoire], references: [id, territoire], onDelete: Cascade, onUpdate: Restrict)
  jour_ferie JourFerie? @relation(fields: [jour_ferie_id, date, territoire], references: [id, date, territoire], onDelete: Restrict, onUpdate: Restrict)

  @@unique([agence_id, date])
  @@index([agence_id])
  @@map("calendrier_ferie")
}

// ── Référentiel client (ticket L1-01, D29, chapitre 11.2) ───────────────────

/// Fiche client — PREMIÈRE table métier du lot 1, et première table métier
/// ordinaire du dépôt (I1, 1ʳᵉ catégorie) : `societe_id NOT NULL`, RLS activée
/// ET forcée.
///
/// **Sa politique est de forme « PARC », jamais la clause société seule**
/// (D10, D22). Le ticket L0-04 écrit « forme imposée » au singulier ; il y en a
/// cinq, et recopier celle-là ici écrirait une politique fausse dans le sens
/// permissif — en obéissant. Deux clients d'une MÊME société ne sont pas
/// séparés par le filtre société : seul `app.client_id` les sépare, et sans lui
/// un compte portail (D10) verrait la fiche de tous les autres clients de sa
/// société. La clause posée par la migration est exactement celle que le
/// harnais d'isolation posait sur la table fixture, de sorte que les scénarios
/// de L0-05 se REPORTENT sur cette table au lieu de partir avec la fixture
/// (contrat R0-a, écart É14).
///
/// `client` ne porte pas le filtre `app.perimetre_sites` : elle EST le client,
/// il n'y a pas de site au-dessus d'elle. `site` (L1-02) et `machine` (L2-01)
/// le porteront.
///
/// **Hors du périmètre d'audit de I8**, dont la liste — `scripts/lib/perimetre-audit.ts`
/// — est close des deux côtés : y faire entrer `client` est un arbitrage, pas
/// une décision de ticket (revue R0, écart É-b).
model Client {
  demandes Demande[]

  interventions Intervention[]

  id                   String  @id @db.Uuid
  societe_id           String  @db.Uuid
  /// Clé de rapprochement à l'import (RG-IMP-05, amendée par D29). S'appelait
  /// `code_winpro` avant D29 : le produit est vendu à des sociétés qui
  /// n'utilisent pas Winpro, et une colonne ne se nomme pas d'après l'outil
  /// d'un seul client.
  ///
  /// **Nullable**, parce que D29 l'exige : « son absence ne suffit plus à
  /// rejeter la ligne ». Un client créé directement dans CODIPLAN n'en a pas,
  /// et se rapproche par raison sociale au prochain import.
  ///
  /// **Unique DANS la société** quand il est présent — c'est la condition
  /// d'existence de RG-IMP-05, non une précaution : deux fiches partageant un
  /// code rendraient le rapprochement indéterminé sans qu'aucune erreur ne se
  /// produise. Les NULL ne se heurtent pas dans un index unique PostgreSQL.
  ///
  /// Son LIBELLÉ d'affichage est paramétrable par société :
  /// `societe.libelle_code_externe`.
  code_externe         String?
  /// Raison sociale. Obligatoire et non vide (contrainte `CHECK` en base : Zod
  /// ne voit pas l'import Excel ni une correction manuelle).
  ///
  /// **Pas d'unicité**, et c'est une décision : RG-IMP-05 range l'ambiguïté de
  /// raison sociale en « rejet pour arbitrage humain ». Une contrainte en base
  /// transformerait cet arbitrage en refus, à la saisie plutôt qu'à l'import.
  raison_sociale       String
  /// Numéro d'identification des entreprises de Nouvelle-Calédonie. Aucun
  /// contrôle de forme : le cahier des charges n'en donne aucun, et inventer un
  /// motif refuserait des données justes.
  ridet                String?
  /// Catégorie client. **Texte libre, et délibérément pas une énumération** :
  /// le chapitre 11 nomme la notion sans l'énumérer, le chapitre 10 est muet, et
  /// fermer une énumération avant d'avoir tranché à qui l'on vend est l'erreur
  /// du 20/08 (CLAUDE.md §9). L'énumérer sera un arbitrage.
  categorie            String?
  /// Adresse de facturation, en JSON comme `agence.adresse` : une adresse
  /// calédonienne — boîte postale, tribu, commune — n'a pas la forme d'une
  /// adresse métropolitaine, et figer des colonnes déciderait d'un format que
  /// le cahier des charges ne donne pas.
  adresse_facturation  Json?
  /// Conditions de règlement. Texte libre pour la même raison que `categorie` :
  /// aucune énumération n'est arrêtée.
  conditions_reglement String?
  /// Commercial référent, en TEXTE et non en clé étrangère vers `utilisateur`.
  /// Le référent d'un client importé de l'ERP n'est pas nécessairement un compte
  /// de la plateforme, et le lier à `utilisateur` déciderait le contraire. Le
  /// jour où L1-04 livre les techniciens et les habilitations, le rattacher sera
  /// un arbitrage — pas une conséquence.
  commercial_referent  String?
  actif                Boolean @default(true)

  /// Les DEUX actions sont dites (CLAUDE.md §9, 24/08), et refusent toutes deux
  /// plutôt que de propager. `Restrict` en suppression : effacer une société
  /// emporterait son référentiel client. `Restrict` en mise à jour, et NON le
  /// `Cascade` que Prisma pose par défaut — c'est la leçon de D49 : `societe.id`
  /// est un UUID v7 technique (I10) qui ne change jamais, et `Cascade`
  /// promettrait silencieusement de réécrire tout un parc client si cela
  /// survenait.
  societe  Societe             @relation(fields: [societe_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sites    Site[]
  comptes  UtilisateurClient[]
  contacts Contact[]
  machines Machine[]

  @@unique([societe_id, code_externe])
  /// Clé composite technique — cible du chaînage de `site` et de
  /// `utilisateur_client` (L1-02, sur le modèle de D48). `id` étant déjà la clé
  /// primaire, elle n'ajoute aucune unicité : elle rend simplement le couple
  /// (société, client) référençable d'un seul geste, de sorte qu'une ligne
  /// fille ne puisse pas désigner le client d'une AUTRE société. Les contrôles
  /// d'intégrité référentielle contournent les politiques RLS par construction
  /// en PostgreSQL : sans la société dans la clé, le verrou serait muet
  /// exactement là où le cloisonnement doit mordre.
  @@unique([societe_id, id])
  @@map("client")
}

/// Site d'intervention chez un client (ticket L1-02, chapitre 11.2, D23).
///
/// Table métier ordinaire de la PREMIÈRE catégorie de I1 : `societe_id NOT
/// NULL`, RLS activée ET forcée, politique de forme « PARC » — société ET
/// `app.client_id` ET `app.perimetre_sites`. C'est la seule des cinq formes
/// dont les trois filtres mordent tous les trois ici : `site` est la table par
/// laquelle le périmètre de sites d'un compte portail (D10) se lit.
///
/// **« Site » n'est jamais « agence ».** Un site est un lieu d'intervention
/// chez un CLIENT ; une agence est un établissement CODIMA. Les deux mots ne
/// sont pas interchangeables (CLAUDE.md, vocabulaire imposé ; D5, D47), et leur
/// définition vit sous les clés `vocabulaire.*` de `lib/i18n/fr.ts`.
model Site {
  demandes Demande[]

  interventions Intervention[]

  id               String   @id @db.Uuid
  societe_id       String   @db.Uuid
  client_id        String   @db.Uuid
  /// **L'agence dont ce site dépend** (D56). Un site dépend d'une agence et
  /// d'une seule, toujours la même — c'est ce que l'exploitation a confirmé, et
  /// c'est ce que le backlog voulait dire par « temps de trajet par agence » :
  /// non pas une valeur par couple, mais le trajet depuis l'agence dont le site
  /// dépend.
  ///
  /// **OBLIGATOIRE, et la question s'est posée au bon moment** (CLAUDE.md §9,
  /// 23/08). Une colonne nullable aurait rendu le chaînage composite
  /// facultatif : en `MATCH SIMPLE`, une clé étrangère dont une colonne vaut
  /// NULL n'est pas contrôlée. Surtout, elle aurait laissé exister des sites
  /// dont `temps_trajet_min` ne dit pas d'où l'on part — c'est-à-dire le
  /// défaut même que D56 corrige.
  agence_id        String   @db.Uuid
  /// Libellé du site. Obligatoire et non vide (contrainte `CHECK` en base).
  ///
  /// **Aucune unicité**, et c'est une décision de même nature que celle prise
  /// sur `client.raison_sociale` à L1-01 : rien au chapitre 10 n'en fait une
  /// clé, et une contrainte en base transformerait en refus de saisie ce que
  /// RG-IMP-05 range en rapprochement puis arbitrage humain. Deux ateliers
  /// « Zone industrielle » chez le même client sont un cas réel.
  libelle          String
  /// Adresse du site, en JSON comme `client.adresse_facturation` et
  /// `agence.adresse` : une adresse calédonienne — boîte postale, tribu,
  /// commune — n'a pas la forme d'une adresse métropolitaine, et figer des
  /// colonnes déciderait d'un format que le cahier des charges ne donne pas.
  adresse          Json?
  /// Commune. Colonne à part de l'adresse parce que le chapitre 11.2 la nomme
  /// séparément : c'est un critère de regroupement, pas une ligne d'adresse.
  commune          String?
  /// Zone géographique (D23) — `grand_noumea`, `sud`, `cote_est`, `cote_ouest`,
  /// `nord`, `iles`.
  ///
  /// **Du TEXTE, et l'énumération n'est pas fermée en base.** D23 arrête bien
  /// la liste, et `lib/sites/zones.ts` la tient close à l'entrée serveur — Zod,
  /// sur tous les chemins sans exception (CLAUDE.md §2). Mais ces six valeurs
  /// sont celles d'UN territoire : `grand_noumea` n'a aucun sens pour une
  /// société vendue en métropole, et CODIMA-EU en est déjà une au jeu de
  /// démonstration. Les figer en `CHECK` ou en type énuméré ferait de la
  /// géographie de la Nouvelle-Calédonie une contrainte du produit — c'est la
  /// forme exacte de l'erreur du 19/08 (`code_winpro`) et de celle du 20/08
  /// (fermer une énumération avant d'avoir tranché à qui l'on vend). Le point
  /// est porté au registre des arbitrages du ticket.
  zone_geo         String?
  /// Latitude en degrés décimaux (WGS 84). `Decimal(9,6)` — six décimales
  /// valent environ onze centimètres, ce qui excède tout besoin d'un site
  /// d'intervention. Les bornes sont contraintes en base : ce n'est pas une
  /// règle de gestion mais la définition même de la mesure.
  latitude         Decimal? @db.Decimal(9, 6)
  /// Longitude en degrés décimaux (WGS 84). Voir `latitude`.
  longitude        Decimal? @db.Decimal(9, 6)
  /// Consignes d'accès et de sécurité — badge, EPI, induction sécurité,
  /// autorisation préalable. Le chapitre 2 les dit « décisives pour les sites
  /// miniers ». Texte libre : ce sont des phrases écrites par un humain pour un
  /// humain, jamais un critère de calcul.
  consignes_acces  String?
  /// Horaires d'accès du site, en JSON — une liste de plages hebdomadaires de
  /// même forme que `calendrier_plage` (jour ISO 1-7, minutes locales depuis
  /// minuit), tenue close par Zod dans `lib/sites/saisie.ts`.
  ///
  /// **En JSON et non dans une table, et c'est une décision qu'il faut lire.**
  /// Une table fille `site_horaire` serait plus juste sur le papier ; elle
  /// porterait `societe_id NOT NULL`, entrerait donc dans la première catégorie
  /// de I1, et réclamerait une FORME de politique. Or aucune des cinq ne lui
  /// va : la forme « société » laisserait un compte portail restreint au site
  /// S1 lire les horaires du site S2 du même client — le filtre de périmètre
  /// vit dans la forme « parc », et étendre `TABLES_PARC` est un ARBITRAGE, pas
  /// une décision de ticket (`scripts/lib/politiques-rls.ts`). Portées par
  /// `site` elle-même, ces données héritent de la politique « parc » de leur
  /// site et le périmètre les protège par construction. I7 borne le risque : les
  /// horaires d'un site produisent un AVERTISSEMENT, jamais un blocage.
  horaires         Json?
  /// Temps de trajet de référence, en minutes, **DEPUIS `agence_id`** (D23,
  /// D56, RG-PLA-05).
  ///
  /// **Ce nombre ne veut rien dire seul, et c'est tout l'objet de D56.** « 45 »
  /// ne dit pas d'où l'on part. Tant que le rattachement n'était pas dans la
  /// donnée, la valeur n'était interprétable que par quelqu'un qui connaissait
  /// déjà la réponse — et le jour où une quatrième agence ouvre, personne
  /// n'aurait su quelles valeurs revoir. La dépendance est donc écrite ici, à
  /// côté du nombre, et surtout TENUE : le déclencheur
  /// `site_trajet_suit_agence` refuse de changer `agence_id` sans que
  /// `temps_trajet_min` soit revu dans la même instruction, et Zod pose la
  /// même exigence à l'entrée serveur.
  ///
  /// La valeur saisie **fait foi** ; l'estimation par zone n'est qu'un défaut
  /// appliqué en son absence (D23). `NULL` est donc une valeur pleine : « je ne
  /// mesure pas, estime depuis la zone ».
  ///
  /// **DONNÉE DE PLANIFICATION, ET RIEN D'AUTRE (D74).** Elle sert au calcul
  /// de charge et aux tournées. Elle ne s'ajoute JAMAIS aux heures facturées :
  /// le déplacement se facture par un forfait conditionné par zone
  /// (RG-INT-07, RG-TAR-06), et l'additionner aux heures facturerait le
  /// déplacement deux fois. Écrit ici parce que c'est ici qu'on la lira le
  /// jour où on voudra s'en servir.
  temps_trajet_min Int?
  actif            Boolean  @default(true)
  /// Sous contrat de maintenance (CONTRAT-SITE-1, arbitrage du 23/09/2026) —
  /// une case, et rien de plus : le vrai module Contrats (chapitre 7/M3,
  /// `docs/maquette/…/contrats()`) reste reporté. Aucune date, aucune
  /// référence, aucun montant : cette colonne dit seulement si le site EST
  /// couvert, jamais depuis quand ni jusqu'à quand.
  ///
  /// `false` par défaut, et TOUS les sites démarrent à `false` — y compris
  /// ceux déjà en production : c'est Alexis qui coche, cette migration ne
  /// décide pour personne.
  sous_contrat     Boolean  @default(false)

  /// Les DEUX actions sont dites (CLAUDE.md §9, 24/08), et refusent toutes deux
  /// plutôt que de propager. `Restrict` en suppression : effacer une société
  /// emporterait ses sites. `Restrict` en mise à jour, et NON le `Cascade` de
  /// Prisma — `societe.id` est un UUID v7 technique (I10) qui ne change jamais.
  societe Societe @relation(fields: [societe_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Chaînage COMPOSITE vers le client, sur le modèle de D48 : `(societe_id,
  /// client_id)` vers `(societe_id, id)`. Une clé sur `client_id` seul
  /// laisserait un site désigner le client d'une AUTRE société — les contrôles
  /// d'intégrité référentielle contournent les politiques RLS par construction
  /// en PostgreSQL. `Restrict` en suppression : un client qui a des sites ne
  /// s'efface pas, et `Cascade` effacerait un parc entier sur un geste
  /// d'administration. `Restrict` en mise à jour : ni `client.id` ni
  /// `client.societe_id` ne changent (I10, RG-SOC-04).
  client  Client  @relation(fields: [societe_id, client_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)
  /// Chaînage COMPOSITE vers l'agence de rattachement (D56), sur le modèle de
  /// D48 : `(societe_id, agence_id)` vers `(societe_id, id)`. Une clé sur
  /// `agence_id` seul laisserait un site se rattacher à l'agence d'une AUTRE
  /// société — les contrôles d'intégrité référentielle contournent les
  /// politiques RLS par construction en PostgreSQL.
  ///
  /// `Restrict` en suppression : une agence dont des sites dépendent ne
  /// s'efface pas — `Cascade` emporterait le parc, et `SetNull` est impossible,
  /// la colonne étant `NOT NULL`. `Restrict` en mise à jour : `agence.id` est
  /// un UUID v7 technique (I10) qui ne change jamais, et une agence ne change
  /// pas de société.
  agence  Agence  @relation(fields: [societe_id, agence_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)

  /// Cible du chaînage composite depuis `utilisateur_client_site` (L1-02b).
  perimetres             UtilisateurClientSite[]
  contacts               Contact[]
  habilitations_requises SiteHabilitationRequise[]
  machines               Machine[]

  /// Cible du chaînage TRIPLE depuis `contact` : un contact rattaché à un site
  /// doit l'être à un site DE SON CLIENT, et c'est la clé qui le tient.
  @@unique([societe_id, client_id, id])
  /// Sans la société DANS la clé, un périmètre pourrait désigner le site d'une
  /// AUTRE société — et les contrôles d'intégrité référentielle contournent les
  /// politiques RLS par construction.
  @@unique([societe_id, id])
  @@index([societe_id, client_id])
  @@index([societe_id, agence_id])
  @@map("site")
}

/// Compte d'accès (chapitre 11 §11.2). L'habilitation multi-société n'est pas
/// portée ici mais par `utilisateur_societe`.
///
/// Ticket L0-06 : Better Auth est branché SUR cette table, et non sur une table
/// `user` parallèle — un compte, une identité. Le hash du mot de passe quitte
/// donc cette table pour `compte.mot_de_passe`, là où Better Auth le range
/// (un utilisateur peut avoir plusieurs moyens d'authentification) ;
/// `mfa_actif` porte le `twoFactorEnabled` du greffon second facteur.
///
/// **QUATRIÈME catégorie de I1 — table d'identité de plateforme (D39).** Elle
/// est seule dans sa catégorie, et ne porte pas de `societe_id` : l'identité est
/// unique au niveau plateforme (D35), les habilitations sont par société. Elle
/// n'est pas rangée avec les tables techniques d'authentification parce qu'elle
/// n'a pas leur régime de conservation : une session expire, une vérification se
/// consomme, un second facteur se révoque — une identité est durable, porte des
/// données personnelles, et sera exposée dans la console éditeur au lot 7. Une
/// future purge des tables techniques ne doit pas pouvoir l'emporter.
///
/// **AUCUNE DONNÉE MÉTIER ICI.** C'est ce qui rend son non-cloisonnement
/// acceptable, et ce n'est pas une recommandation : fonction, agence de
/// rattachement, habilitations, préférences vivent dans `utilisateur_societe`,
/// qui est cloisonnée. Cette table ne porte que ce qui sert à TROUVER et à
/// AUTHENTIFIER un compte. Le gardien
/// `tests/unit/auth/utilisateur-sans-donnee-metier.test.ts` lit ce fichier et
/// échoue si une colonne s'ajoute ici sans arbitrage.
model Utilisateur {
  id                 String    @id @db.Uuid
  nom                String
  email              String    @unique
  email_verifie      Boolean   @default(false)
  avatar_url         String?
  mfa_actif          Boolean   @default(false)
  actif              Boolean   @default(true)
  derniere_connexion DateTime?
  cree_le            DateTime  @default(now())
  modifie_le         DateTime  @updatedAt

  societes         UtilisateurSociete[]
  clients          UtilisateurClient[]
  sessions         Session[]
  comptes          Compte[]
  seconds_facteurs SecondFacteur[]
  acces_journalise JournalAcces[]

  @@map("utilisateur")
}

/// Habilitation d'un utilisateur interne sur une société, avec son rôle.
/// C'est cette table qui porte le multi-société (chapitre 11 §11.2).
model UtilisateurSociete {
  id             String @id @db.Uuid
  utilisateur_id String @db.Uuid
  societe_id     String @db.Uuid
  role           Role

  utilisateur Utilisateur @relation(fields: [utilisateur_id], references: [id])
  societe     Societe     @relation(fields: [societe_id], references: [id])

  habilitations TechnicienHabilitation[]
  absences      Absence[]
  segments      SegmentTravail[]

  @@unique([utilisateur_id, societe_id])
  @@map("utilisateur_societe")
}

/// Rattachement d'un compte portail à un client (D10). Exclusif de
/// `utilisateur_societe` : un compte portail n'a aucune ligne là-bas.
///
/// **`client_id` a cessé d'être une référence logique au ticket L1-02.** Elle
/// l'était depuis L0-03 faute de table `client`, et l'est restée à L1-01 : la
/// base de démonstration portait alors une ligne désignant un client
/// inexistant, et poser la clé y aurait fait échouer la migration. Cette ligne
/// n'était pas l'empêchement, elle était la DÉMONSTRATION — c'est exactement ce
/// que la contrainte interdit. La migration de L1-02 la traite comme une donnée
/// à réparer, puis pose la clé.
///
/// **Le chaînage est COMPOSITE — `(societe_id, client_id)` vers
/// `(societe_id, id)`, sur le modèle de D48.** Une clé sur `client_id` seul
/// laisserait un compte portail désigner le client d'une AUTRE société : les
/// contrôles d'intégrité référentielle contournent les politiques RLS par
/// construction en PostgreSQL, et le verrou serait alors muet là précisément où
/// le cloisonnement doit mordre.
///
/// **`perimetre_sites` reste SANS clé étrangère, et ce n'est pas un oubli.**
/// PostgreSQL 16 ne sait pas contraindre les ÉLÉMENTS d'un tableau : il n'existe
/// pas de `FOREIGN KEY (EACH ELEMENT OF …)`, et la mesure est consignée dans la
/// note de décision du ticket. Ce n'est donc pas un arbitrage qu'on repousse,
/// c'est une impossibilité déclarative — et la sortie (normaliser en table, ou
/// doubler par un déclencheur) est un arbitrage à part entière, posé au registre.
/// `perimetre_sites` vide signifie « tous les sites du client ».
model UtilisateurClient {
  id             String  @id @db.Uuid
  utilisateur_id String  @db.Uuid
  client_id      String  @db.Uuid
  societe_id     String  @db.Uuid
  actif          Boolean @default(true)

  /// Le périmètre de sites (RG-DRO-01) — une TABLE depuis L1-02b, plus un
  /// `String[]`. PostgreSQL 16 ne sait pas contraindre les ÉLÉMENTS d'un
  /// tableau : la colonne acceptait un site inexistant ou d'une autre société,
  /// et un périmètre qui désigne le site d'une autre société ne restreint rien.
  perimetre UtilisateurClientSite[]

  utilisateur Utilisateur @relation(fields: [utilisateur_id], references: [id])
  societe     Societe     @relation(fields: [societe_id], references: [id])
  /// Les DEUX actions sont dites (CLAUDE.md §9, 24/08), et refusent toutes deux.
  /// `Restrict` en suppression : effacer un client dont des comptes portail
  /// dépendent est refusé — `Cascade` retirerait des habilitations sans que
  /// personne ne l'ait demandé, et `SetNull` est impossible, la colonne étant
  /// `NOT NULL`. `Restrict` en mise à jour : `client.id` est un UUID v7
  /// technique (I10) qui ne change jamais, et `client.societe_id` ne change pas
  /// davantage — un client ne déménage pas d'une société à l'autre (RG-SOC-04).
  client      Client      @relation(fields: [societe_id, client_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([utilisateur_id, client_id])
  /// Cible du chaînage composite depuis `utilisateur_client_site` : sans la
  /// société DANS la clé, un périmètre pourrait s'adosser à l'habilitation
  /// d'une AUTRE société, et les contrôles d'intégrité référentielle
  /// contournent les politiques RLS par construction.
  @@unique([societe_id, id])
  @@map("utilisateur_client")
}

/// Le PÉRIMÈTRE DE SITES d'un compte portail (L1-02b, D10, RG-DRO-01).
///
/// Une ligne = un site que ce compte a le droit de voir. AUCUNE ligne = tous
/// les sites de son client, **jamais aucun** : c'est la convention que lit
/// `app.perimetre_sites`, et l'inverser retirerait tous les droits au lieu de
/// les ouvrir.
///
/// Table métier de la PREMIÈRE catégorie de I1 — `societe_id NOT NULL`, RLS
/// activée et forcée, auditée par défaut (D55). Sa politique est de forme
/// « habilitation », la sixième : société ET, pour un compte portail seulement,
/// les lignes dont il voit l'habilitation parente.
model UtilisateurClientSite {
  id                    String @id @db.Uuid
  societe_id            String @db.Uuid
  utilisateur_client_id String @db.Uuid
  site_id               String @db.Uuid

  societe Societe @relation(fields: [societe_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// `Cascade` en suppression, et c'est la SEULE des trois clés qui propage :
  /// le périmètre n'a aucune vie propre, il ne signifie rien sans
  /// l'habilitation qu'il restreint. `Restrict` obligerait à le vider à la main
  /// avant de retirer un compte portail — une étape que quelqu'un oubliera. La
  /// cascade reste auditée : le déclencheur de I8 est `FOR EACH ROW`.
  /// `Restrict` en mise à jour : ni l'identifiant ni la société d'une
  /// habilitation ne changent (RG-SOC-04).
  habilitation UtilisateurClient @relation(fields: [societe_id, utilisateur_client_id], references: [societe_id, id], onDelete: Cascade, onUpdate: Restrict)

  /// `Restrict` en suppression : effacer un site qu'un périmètre nomme est
  /// refusé. `Cascade` élargirait le périmètre EN SILENCE — retirer la ligne
  /// qui restreint revient à lever la restriction —, et c'est le pire sens dans
  /// lequel une action référentielle puisse se tromper (§9, 24/08).
  /// `Restrict` en mise à jour : `site.id` est un UUID v7 technique (I10).
  site Site @relation(fields: [societe_id, site_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([utilisateur_client_id, site_id])
  @@index([societe_id, utilisateur_client_id])
  @@map("utilisateur_client_site")
}

// ── Authentification et rôles (ticket L0-06, arbitrages D21 et gravité 4) ────
//
// Better Auth est branché sur la table `utilisateur` ci-dessus ; les quatre
// tables qui suivent sont les siennes, renommées dans la langue du schéma.
// Leurs noms de champs Prisma sont ceux que la configuration de
// `lib/auth/config.ts` déclare — la correspondance est explicite, jamais
// devinée.
//
// Aucune de ces tables ne porte de `societe_id`. Elles forment la TROISIÈME
// catégorie de I1 — les tables techniques d'authentification (D34, D39) : liste
// close, `session`, `compte`, `verification`, `second_facteur`, `journal_acces`.
// Elles portent la trace technique, pas la donnée métier, et l'authentification
// doit pouvoir chercher un compte avant qu'aucune société ne soit active.
//
// `utilisateur` n'en fait PAS partie : elle relève de la QUATRIÈME catégorie,
// à elle seule (D39). Ces cinq tables-ci sont purgeables — une session expire,
// une vérification se consomme, un second facteur se révoque ; une identité est
// durable. Voir I1 et
// docs/decisions/2026-08-20-authentification-et-deux-connexions.md.
//
// Le cloisonnement société s'applique à `utilisateur_societe` et
// `utilisateur_client`, qui disent qui est habilité où, et c'est par elles que
// passe toute décision d'accès. La sécurité au niveau des lignes n'est donc pas
// activée sur les tables ci-dessous.

/// Session serveur (I1, L0-06). Elle porte la société active et le rôle tenu
/// sur cette société : c'est `societe_id_active` qui alimente `app.societe_id`
/// et `role_actif` qui alimente `app.role`. Une session sans société active ne
/// lit rien — les politiques RLS renvoient zéro ligne sans contexte.
model Session {
  id                    String   @id @db.Uuid
  token                 String   @unique
  utilisateur_id        String   @db.Uuid
  expire_le             DateTime
  adresse_ip            String?
  agent_utilisateur     String?
  societe_id_active     String?  @db.Uuid
  role_actif            Role?
  second_facteur_valide Boolean  @default(false)
  cree_le               DateTime @default(now())
  modifie_le            DateTime @updatedAt

  utilisateur    Utilisateur @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade)
  societe_active Societe?    @relation(fields: [societe_id_active], references: [id])

  @@index([utilisateur_id])
  @@map("session")
}

/// Moyen d'authentification rattaché à un compte (table `account` de Better
/// Auth). Le mot de passe y est rangé sous forme de hash — jamais sur
/// `utilisateur`. Les colonnes de jetons servent aux fournisseurs externes ;
/// aucune n'est utilisée en V1, mais Better Auth exige leur présence.
model Compte {
  id                               String    @id @db.Uuid
  utilisateur_id                   String    @db.Uuid
  emetteur                         String
  compte_externe_id                String
  fournisseur_id                   String
  mot_de_passe                     String?
  jeton_acces                      String?
  jeton_rafraichissement           String?
  jeton_identite                   String?
  jeton_acces_expire_le            DateTime?
  jeton_rafraichissement_expire_le DateTime?
  portee                           String?
  cree_le                          DateTime  @default(now())
  modifie_le                       DateTime  @updatedAt

  utilisateur Utilisateur @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade)

  @@unique([emetteur, compte_externe_id])
  @@index([utilisateur_id])
  @@map("compte")
}

/// Jetons à usage unique de Better Auth : vérification d'adresse, réinitialisation
/// de mot de passe, second facteur en attente.
model Verification {
  id          String   @id @db.Uuid
  identifiant String
  valeur      String
  expire_le   DateTime
  cree_le     DateTime @default(now())
  modifie_le  DateTime @updatedAt

  @@index([identifiant])
  @@map("verification")
}

/// Second facteur TOTP et codes de secours (greffon `twoFactor`). Obligatoire
/// pour les rôles `admin_plateforme` et `direction` — §22.5 et §12.1 du cahier
/// des charges ; la règle est portée par `lib/auth/roles.ts`.
model SecondFacteur {
  id                  String    @id @db.Uuid
  utilisateur_id      String    @db.Uuid
  secret              String
  codes_secours       String
  verifie             Boolean   @default(true)
  echecs_verification Int       @default(0)
  verrouille_jusqu_a  DateTime?

  /// Verrouillages temporaires ENCHAÎNÉS, sans connexion réussie entre eux (D62).
  /// Écrite par le seul déclencheur `second_facteur_escalade` : l'application ne
  /// la pose jamais, et le déclencheur ignore ce qu'un appelant y mettrait. Au
  /// troisième, le verrouillage cesse d'expirer — le déblocage devient l'acte
  /// administratif L7-04.
  verrouillages_consecutifs Int @default(0)

  utilisateur Utilisateur @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade)

  @@index([utilisateur_id])
  @@index([secret])
  @@map("second_facteur")
}

/// Événements d'accès journalisés (D32, dernier alinéa).
enum EvenementAcces {
  bascule_societe
  bascule_refusee
  requete_consolidation
  /// L'OUVERTURE D'UNE IDENTITÉ EST UN ÉVÉNEMENT D'ACCÈS (Q1 / D65,
  /// 09/09/2026). Règle générale, et la raison est mécanique : une identité
  /// n'appartient à AUCUNE société, alors que `journal_audit` est cloisonné par
  /// société et partitionné — l'y faire entrer casserait son partitionnement.
  /// Elle vaudra telle quelle pour le chemin administratif du lot 7 : la valeur
  /// nomme donc l'ÉVÉNEMENT, jamais le chemin, qui va dans `detail`.
  ouverture_identite
  /// RÉÉMISSION du jeton de premier accès d'une identité qui n'a JAMAIS servi
  /// (10/09/2026, complément de D65). Le jeton d'amorçage vit une heure ; expiré,
  /// il ne laissait aucune voie de retour — le second appel du geste étant
  /// refusé, et l'instance de production n'émettant rien. Ce geste la rend.
  /// Son cliquet est plus ÉTROIT que celui de l'amorçage : il se ferme dès qu'un
  /// mot de passe existe, et pour toujours. L'événement nomme ce qui s'est
  /// passé — un jeton de plus a été émis —, jamais le chemin.
  reemission_premier_acces
  /// Déverrouillage d'un compte parvenu à l'ESCALADE du second facteur
  /// (L7-04 / D66). *Déverrouiller n'accorde aucun accès* : la personne devra
  /// toujours présenter un code valide. C'est ce qui distingue L7-04 de L7-01,
  /// qui rend un accès PERDU.
  deverrouillage_second_facteur
}

/// Journal des accès — distinct du `journal_audit` du ticket L0-10, qui portera
/// les valeurs avant/après des écritures métier. Celui-ci enregistre ce que D32
/// conserve des LECTURES : « les accès des rôles éditeur aux données d'une
/// société cliente, et les basculements de société active », plus la
/// journalisation des requêtes de consolidation exigée par D21.
///
/// Il enjambe les sociétés par nature — une bascule refusée de A vers B ne peut
/// se ranger ni sous A ni sous B —, il ne porte donc pas de `societe_id NOT
/// NULL` et n'est pas soumis au cloisonnement. C'est une **table technique
/// d'authentification** au sens de la troisième catégorie de I1 (D34), au même
/// titre que `session`, `compte` et `verification`, et non une table métier.
/// Il est en ajout seul : la migration retire `UPDATE` et `DELETE` au rôle
/// applicatif.
///
/// **`societe_id_source` et `societe_id_cible` sont INFORMATIVES** (D34). Elles
/// répondent à une question, et à une seule : « qui a tenté d'accéder à mes
/// données ». Elles ne filtrent jamais — ni ici, ni dans une politique RLS, ni
/// dans une requête applicative. C'est pourquoi elles sont nullables, sans clé
/// étrangère et sans index : une clé étrangère ou un index seraient la signature
/// d'un usage de filtrage, et le premier filtre écrit sur elles ferait croire
/// que le journal est cloisonné alors qu'il ne l'est pas. Le gardien
/// `tests/unit/auth/journal-acces-informatif.test.ts` échoue si l'une d'elles
/// apparaît dans un `where`.
model JournalAcces {
  id                String         @id @db.Uuid
  horodatage        DateTime       @default(now())
  utilisateur_id    String         @db.Uuid
  evenement         EvenementAcces
  /// Société active AVANT la tentative — informative, jamais filtrante (D34).
  societe_id_source String?        @db.Uuid
  /// Société VISÉE par la tentative — informative, jamais filtrante (D34).
  societe_id_cible  String?        @db.Uuid
  role              Role?
  detail            String?

  utilisateur Utilisateur @relation(fields: [utilisateur_id], references: [id])

  @@index([utilisateur_id, horodatage])
  @@map("journal_acces")
}

// ── Journal d'audit (ticket L0-10, invariant I8, arbitrages D32 et D50) ──────
//
// **Le journal est écrit par un DÉCLENCHEUR PostgreSQL, jamais par du code
// applicatif.** C'est le principe de L0-04 et de D51 appliqué une troisième
// fois : la garantie se place au point de passage obligé. Un intercepteur
// Prisma ne couvre que les chemins qui passent par Prisma — il laisse dehors le
// script de correction, l'import Excel, le `psql` d'un soir de production.
// L'écriture d'une ligne d'audit n'est donc pas une politesse du service qui
// écrit : c'est une conséquence de l'écriture elle-même (D32).
//
// **Le journal est en AJOUT SEUL.** Le rôle applicatif détient `SELECT` et
// `INSERT`, et rien d'autre : `UPDATE` et `DELETE` lui sont retirés par la
// migration, et aucune politique ne les autorise. L'histoire s'écrit, elle ne
// se réécrit pas. Le contrôle est fait par observation — `information_schema`,
// dans `scripts/controle-cloisonnement.mts` — et non par déclaration, comme
// pour `codiplan_reporting` (D38).
//
// **PAS de `SECURITY DEFINER`, et c'est tranché** (ticket L0-10, point 3). La
// forme classique serait un déclencheur `SECURITY DEFINER` appartenant au
// propriétaire ; D50 l'interdit, sa liste d'exceptions est close et vide, et ce
// ticket ne l'ouvre pas. Le raisonnement tient en une phrase : **ce contre quoi
// nous protégeons est la RÉÉCRITURE de l'histoire, pas l'insertion d'une
// ligne.** Une application compromise peut déjà mentir dans les tables métier —
// le journal l'enregistrerait fidèlement. La propriété qui compte est l'ajout
// seul, et `INSERT` sans `UPDATE` ni `DELETE` la donne, sous
// `SECURITY INVOKER`.

/// Nature de l'écriture journalisée. Trois valeurs, celles de I8 — « toute
/// création, modification ou suppression ». `TG_OP` du déclencheur s'y traduit
/// terme à terme, et rien d'autre n'y entre : une lecture n'est pas une
/// écriture, et les lectures qui se journalisent ont leur propre table
/// (`journal_acces`, D32 dernier alinéa).
enum ActionAudit {
  creation
  modification
  suppression
}

/// Journal d'audit (chapitre 11.2 ; I8 ; D32) — **table métier, PREMIÈRE
/// catégorie de I1** : `societe_id NOT NULL`, politique de cloisonnement,
/// `FORCE ROW LEVEL SECURITY`.
///
/// **POURQUOI `societe_id` EST OBLIGATOIRE, ET CE QUE CELA DÉCIDE.** Le journal
/// n'enregistre que des lignes de tables cloisonnées ; il porte donc la société
/// de la ligne qu'il décrit, et cette société existe toujours. La conséquence
/// est qu'il **ne couvre pas les référentiels de plateforme** — `devise`,
/// `parite`, `jour_ferie` —, qui n'ont pas de société à porter. Ce n'est pas un
/// oubli : c'est le périmètre de I8 et de D32 (« intervention, contrat,
/// machine, paramétrage société, compte client »), où ces trois tables n'ont
/// jamais figuré. Et ce n'est pas une intention non plus : le déclencheur
/// **refuse de s'exécuter** sur une table qui n'expose aucune société, en la
/// nommant. Les deux autres voies — un `societe_id` nullable, une cinquième
/// catégorie de I1 — sont mesurées dans
/// `docs/decisions/2026-08-29-journal-audit-par-declencheur.md` ; elles exigent
/// toutes deux un arbitrage, et aucune liste close n'est élargie ici.
///
/// **AUCUNE CLÉ ÉTRANGÈRE, ET C'EST DÉLIBÉRÉ.** Ni sur `societe_id`, ni sur
/// `utilisateur_id`. Le journal doit **survivre à ce qu'il décrit** : une clé
/// étrangère vers `societe` rendrait la suppression d'une société soit
/// impossible, soit non journalisable — le déclencheur `AFTER DELETE`
/// tenterait d'écrire une ligne désignant une société qui n'existe plus, et la
/// clé refuserait l'écriture même qu'elle est censée garantir. L'intégrité
/// vient d'ailleurs, et elle suffit : la valeur est **recopiée de la ligne
/// source**, dont la clé étrangère, elle, était contrôlée au moment de
/// l'écriture. À ne pas confondre avec les colonnes informatives de
/// `journal_acces` (D34) : celles-là n'ont ni clé ni index parce qu'elles ne
/// filtrent **jamais** ; `societe_id` ici filtre — c'est la clé du
/// cloisonnement —, elle est donc indexée, et seule la clé étrangère est
/// écartée.
model JournalAudit {
  /// Généré PAR LA BASE (`gen_random_uuid()`), et c'est la seule exception au
  /// UUID v7 de I10 — laquelle répond à « un identifiant créé hors ligne sur un
  /// appareil ». Une ligne d'audit n'est créée par aucun appareil : elle naît
  /// dans le déclencheur, du côté serveur, où la question ne se pose pas.
  ///
  /// **Il n'est PAS clé primaire à lui seul** : voir `@@id` en bas de modèle.
  id             String      @db.Uuid
  /// Société de la ligne journalisée, recopiée d'elle. Jamais du contexte de
  /// session : c'est la ligne qui dit à qui elle appartient.
  societe_id     String      @db.Uuid
  /// Nom de la table journalisée (`TG_TABLE_NAME`).
  entite         String
  /// Identifiant de la ligne journalisée — sa colonne `id`.
  entite_id      String      @db.Uuid
  action         ActionAudit
  /// Clé de PARTITIONNEMENT — la table est partitionnée par mois (L0-10).
  horodatage     DateTime    @default(now()) @db.Timestamptz(6)
  /// Auteur, lu dans `app.utilisateur_id` que pose `lib/db/rls.ts`. **Nullable
  /// à dessein** : une écriture faite hors de toute session — le seed, une
  /// migration, une correction en `psql` — n'a pas d'auteur, et le journal le
  /// dit par un `NULL` plutôt qu'en inventant un compte (CLAUDE.md §8). La
  /// ligne existe quand même : une écriture sans auteur reste une écriture.
  utilisateur_id String?     @db.Uuid
  /// Adresse de l'appelant (chapitre 11.2), lue dans `app.adresse_ip`. Elle
  /// vient de la session que Better Auth a déjà enregistrée, jamais d'un
  /// en-tête recopié à la volée.
  adresse_ip     String?
  /// La ligne AVANT l'écriture, en entier. Nulle à la création.
  valeurs_avant  Json?
  /// La ligne APRÈS l'écriture, en entier. Nulle à la suppression.
  valeurs_apres  Json?

  /// **CLÉ PRIMAIRE COMPOSITE, et ce n'est pas un choix de modélisation.**
  /// La table est partitionnée par mois sur `horodatage` (L0-10), et PostgreSQL
  /// exige que la clé de partitionnement appartienne à toute contrainte
  /// d'unicité. Conséquence à connaître : `id` seul n'est plus déclaré unique.
  /// Rien ne référence `journal_audit.id` — le journal n'a aucune clé étrangère
  /// et personne n'en pose vers lui —, et `gen_random_uuid()` rend la collision
  /// négligeable.
  ///
  /// **Pourquoi la table naît partitionnée plutôt que de le devenir.**
  /// PostgreSQL ne convertit pas une table ordinaire sur place : il faut créer,
  /// copier, indexer, échanger, sous `ACCESS EXCLUSIVE` — donc bloquer en
  /// écriture NON PAS le journal mais l'application entière, puisque toute
  /// écriture métier y insère par le déclencheur. Mesuré : 0,11 s sur les
  /// 104 ko d'aujourd'hui, 2,4 s à deux ans, 17 s à dix ans. Créée
  /// partitionnée, cette reprise n'existe jamais.
  @@id([id, horodatage])
  /// L'usage réel, et l'index est fait pour lui : « qui a changé ce statut
  /// d'intervention, et depuis quelle valeur » — une entité, son identifiant,
  /// dans l'ordre du temps.
  @@index([societe_id, entite, entite_id, horodatage])
  /// Le journal filtrable de la console d'administration (§10.1) : toute
  /// l'activité d'une société, la plus récente d'abord.
  @@index([societe_id, horodatage])
  @@map("journal_audit")
}

/// Contact d'un client (L1-03, chapitre 3 M1, RG-INT-04, RG-INT-05).
///
/// **Un contact appartient au CLIENT, avec un rattachement de site FACULTATIF**
/// (décision d'exploitation du 07/09/2026). Le donneur d'ordre et le comptable
/// sont ceux du client ; chez un client à plusieurs sites, certains
/// interlocuteurs ne concernent qu'un site. `site_id` nul PORTE DU SENS — il
/// dit « contact du client » — et un tel contact ne disparaît pas pour un
/// compte portail restreint à certains sites.
///
/// Politique de forme « parc », avec la DISJONCTION que cette nullité impose.
model Contact {
  demandes      Demande[]
  interventions Intervention[]

  id         String  @id @db.Uuid
  societe_id String  @db.Uuid
  client_id  String  @db.Uuid
  /// NULL = contact du CLIENT. Non nul = contact d'un site, filtré par le
  /// périmètre. Le site doit appartenir au même client : la clé composite
  /// `(societe_id, client_id, site_id)` le tient déclarativement.
  site_id    String? @db.Uuid

  nom       String
  fonction  String?
  telephone String?
  mobile    String?
  email     String?

  /// Ensemble, jamais un scalaire : le donneur d'ordre est souvent aussi le
  /// signataire. `String[]` et non un type énuméré — une société tierce aura
  /// d'autres rôles, et une énumération en base ferait de leur ajout une
  /// migration. La liste connue est close à l'entrée serveur. RG-INT-04 lit
  /// « signataire » ICI : il n'y a pas de colonne à part.
  roles String[]

  /// Canaux de notification. Un seul est implémenté — `email` —, et aucune
  /// passerelle SMS n'est en service ni décidée. Le modèle ne fait pas du SMS
  /// une migration : le jour où une passerelle existe, `sms` s'ajoute à la
  /// liste close de l'entrée serveur. Critère de bascule non daté, au registre.
  canaux String[] @default(["email"])

  actif Boolean @default(true)

  societe Societe @relation(fields: [societe_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// `Restrict` en suppression : effacer un client dont des contacts dépendent
  /// est refusé — RG-INT-04 s'appuie sur eux. `Restrict` en mise à jour :
  /// `client.id` est un UUID v7 technique et un client ne déménage pas d'une
  /// société à l'autre (RG-SOC-04).
  client  Client  @relation(fields: [societe_id, client_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)
  /// `Restrict` en suppression. **`SetNull` aurait été le piège** : il
  /// transformerait EN SILENCE un contact de site en contact de client,
  /// c'est-à-dire l'élargirait à tous les comptes portail du client (§9, 24/08).
  site    Site?   @relation(fields: [societe_id, client_id, site_id], references: [societe_id, client_id, id], onDelete: Restrict, onUpdate: Restrict)

  /// La cible du chaînage de `demande.contact_id` (L2-06). Elle porte le
  /// CLIENT et pas seulement la société : un contact désigné sur une demande
  /// doit appartenir au client de cette demande, et la base le tient plutôt
  /// qu'une vérification applicative — c'est la même forme que le chaînage de
  /// `contact` vers `site`, juste au-dessus.
  @@unique([societe_id, client_id, id])
  @@index([societe_id, client_id])
  @@index([societe_id, site_id])
  @@map("contact")
}

/// Habilitation — la QUALIFICATION elle-même (D9, D60, ticket L1-04).
///
/// **Table MÉTIER cloisonnée, et non un référentiel de plateforme** (D60). Les
/// habilitations électriques françaises sont réglementaires et nationales, ce
/// qui plaidait pour un référentiel ; mais *une nomenclature nationale est un
/// fait de la France, pas un fait de la plateforme*, et le produit est destiné à
/// être vendu ailleurs. La forme « référentiel » dit « ceci vaut pour tout le
/// monde » — ce n'est pas vrai ici. Et une société suivra des qualifications qui
/// ne sont pas réglementaires du tout : « formé sur telle presse ».
///
/// La liste réglementaire garde sa valeur comme AMORÇAGE : une société qui
/// s'ouvre la reçoit par défaut et peut la compléter ou la réduire.
/// Nature d'un forfait (chapitre 11).
///
/// **Une énumération EN BASE, et c'est le raisonnement des zones à l'endroit.**
/// Les zones et les rôles de contact sont clos à l'entrée serveur parce qu'ils
/// décrivent un territoire ou une organisation, et qu'une société tierce en aura
/// d'autres. Ces quatre natures décrivent ce qu'un forfait FAIT dans le moteur
/// de valorisation, et le lot 2 s'appuiera dessus.
enum TypeForfait {
  deplacement
  mise_en_service
  controle
  prestation
}

/// Catalogue de forfaits d'une société (ticket L1-06, chapitre 4.3, RG-TAR-06).
///
/// **La table existe, elle naît VIDE.** Quels forfaits mettre au catalogue et à
/// quels montants est une question d'exploitation — elle est au registre depuis
/// l'ouverture du projet, et l'inventer serait inventer une donnée métier.
/// Fiche machine du parc installé (ticket L2-01, arbitrages D6 et D7).
///
/// **Table métier de la première catégorie de I1**, forme de politique
/// « parc » — société ET `app.client_id` ET `app.perimetre_sites` (D10, D22).
/// La clause est EXACTEMENT celle que le harnais d'isolation posait sur la
/// table fixture, de sorte que la couverture éprouvée depuis L0-05 se reporte
/// sans rien perdre (contrat R0-a).
///
/// **QUATRE champs obligatoires** (D6) : `modele_id`, `client_id`, `site_id`,
/// `numero_serie`. Le numéro illisible se saisit `SN-INCONNU-<référence>` avec
/// `complet = false`, **jamais NULL** : deux `NULL` sont distincts pour un
/// index unique, et une colonne nullable ferait de l'unicité une passoire.
///
/// **La clé technique et le numéro affiché sont deux choses** (D7, I10) : `id`
/// est un UUID v7 généré sur l'appareil, `numero` est attribué par le serveur à
/// la synchronisation. **Le QR encode le jeton, jamais le numéro.**
model Machine {
  intervention_machines InterventionMachine[]

  demandes Demande[]

  id         String @id @db.Uuid
  societe_id String @db.Uuid

  /// Les quatre obligatoires de D6.
  modele_id    String @db.Uuid
  client_id    String @db.Uuid
  site_id      String @db.Uuid
  numero_serie String

  /// TIRÉ AU SORT — 130 bits, jamais dérivé de l'`id` ni du numéro (D71, qui
  /// a remplacé la dérivation de D7 ; I10). *Mesuré le 16/09/2026 : ces deux
  /// lignes disaient encore « dérivé de l'id », et `lib/machines/qr.ts` tire
  /// depuis D71 — une documentation qui survit à sa décision enseigne la
  /// dérivation à qui écrira le prochain chemin d'écriture.* Unique
  /// GLOBALEMENT : le lecteur de QR le présente seul, avant qu'aucune société
  /// ne soit connue.
  qr_token String @unique

  /// Attribué par le SERVEUR à la première synchronisation ; NUL en attendant.
  /// **Aucun code ne l'attribue aujourd'hui** — le compteur par société
  /// appartient à la synchronisation (lot 3).
  numero Int?

  /// La référence que le technicien compose quand la plaque est illisible.
  ///
  /// **UNIQUE PAR SOCIÉTÉ, ET LORSQU'ELLE EST PRÉSENTE** (D6). L'index n'est
  /// PAS déclaré ici et c'est délibéré : il est **PARTIEL** —
  /// `WHERE "reference_interne" IS NOT NULL` —, ce que `@@unique` ne sait pas
  /// exprimer. Un `@@unique` accepterait autant de `NULL` qu'on veut, ce qui
  /// n'est pas faux mais **ne dit pas la règle** : toutes les machines n'ont
  /// pas de référence interne.
  ///
  /// Il vit donc en SQL, dans
  /// `20260913200000_reference_interne_unique_d6`, sous le nom
  /// `machine_societe_reference_interne_key`. *Sans lui, deux fiches d'une même
  /// société porteraient le même `SN-INCONNU-<réf>` — le doublon silencieux que
  /// D6 existe pour supprimer, et il naîtrait sur les fiches les moins
  /// renseignées.* Éprouvé par `tests/isolation/reference-interne-unique.test.ts`,
  /// avec son jumeau.
  reference_interne String?

  localisation         String?
  date_mise_en_service DateTime? @db.Date
  date_vente           DateTime? @db.Date
  facture_origine      String?
  garantie_fin         DateTime? @db.Date

  statut               StatutMachine         @default(en_service)
  criticite            CriticiteMachine      @default(normale)
  machine_remplacee_id String?               @db.Uuid
  source_creation      SourceCreationMachine @default(back_office)

  /// Fiche minimale ou complète — c'est elle qui pilote la file de complétion.
  complet Boolean @default(true)

  /// ── L'EXCEPTION D'UN EXEMPLAIRE, ET SON MOTIF (L9-06, D88) ───────────────
  ///
  /// Une machine peut faire exception à sa famille — un usage particulier, une
  /// modification — et **elle ne le fait jamais sans sa raison** : une exception
  /// sans motif est une exception que personne ne pourra rejuger. La base le
  /// refuse, elle ne le signale pas.
  ///
  /// NULLE, la machine suit son modèle, qui suit sa famille. L'absence n'est pas
  /// « non soumise » : c'est « pas d'exception ».
  vgp_exception       AssujettissementVgp?
  vgp_exception_motif String?

  cree_le    DateTime @default(now())
  modifie_le DateTime @updatedAt

  societe           Societe        @relation(fields: [societe_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  client            Client         @relation(fields: [societe_id, client_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)
  site              Site           @relation(fields: [societe_id, site_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)
  modele            ModeleMateriel @relation(fields: [societe_id, modele_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)
  machine_remplacee Machine?       @relation("MachineRemplacee", fields: [societe_id, machine_remplacee_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)
  remplacantes      Machine[]      @relation("MachineRemplacee")

  /// La documentation PROPRE à cet exemplaire — certificat de conformité,
  /// procès-verbal de mise en service (L8-01). L'écran affiche l'UNION de
  /// celle-ci et de celle du modèle, sans qu'aucune ligne soit copiée (L8-02).
  documents         Document[]
  verifications_vgp VgpVerification[]

  @@unique([societe_id, id])
  @@unique([societe_id, modele_id, numero_serie])
  @@unique([societe_id, numero])
  @@index([societe_id, client_id])
  @@index([societe_id, site_id])
  @@map("machine")
}

/// Cycle de vie d'un actif du parc (chapitre 11.2).
/// L'ASSUJETTISSEMENT AUX VÉRIFICATIONS GÉNÉRALES PÉRIODIQUES (L9-03, D88).
///
/// **TROIS valeurs, jamais une case à cocher.** Une case décochée est
/// indiscernable d'une famille jamais examinée — et un pont élévateur sortirait
/// du registre en silence. `a_determiner` est l'état de NAISSANCE : il dit « on
/// n'a pas regardé », ce qu'aucun booléen ne sait dire.
///
/// `verifie` n'est pas une quatrième réponse à la question « est-ce soumis ? » :
/// c'est ce qu'on écrit quand on a regardé et qu'on a besoin d'un état distinct
/// de « soumis » et de « non soumis » — un matériel examiné dont le texte ne
/// tranche pas encore. *Les quatre valeurs de D88 sont deux COUPLES, et le
/// registre les distingue.*
enum AssujettissementVgp {
  /// Naissance. Personne n'a encore regardé. Apparaît dans la liste des
  /// indéterminés, qui est la moitié DÉTECTIVE du couple (L9-03).
  a_determiner
  /// Examiné, et soumis : la périodicité et la référence du texte deviennent
  /// obligatoires (L9-04), et la base le refuse sans elles.
  soumis
  /// Examiné, et non soumis. Distinct de `a_determiner` : quelqu'un a répondu.
  non_soumis
  /// Examiné, et le texte ne tranche pas. Ce n'est ni un oubli, ni une réponse.
  verifie
}

enum StatutMachine {
  en_service
  en_panne
  arretee
  remplacee
  ferraillee
  /// La fiche ABSORBÉE par une fusion de doublons (D28) — état terminal : hors
  /// du parc actif, des contrats et des échéanciers ; garde son `qr_token`,
  /// dont la résolution rend la SURVIVANTE. Seul producteur : la fusion de
  /// L3-10. Ajoutée le 10/09/2026, le rang 1 l'emportant sur une énumération
  /// fermée sans relire la décision qui la nommait.
  fusionnee
}

/// Ce que l'arrêt de la machine coûte au client.
enum CriticiteMachine {
  bloquante
  importante
  normale
}

/// Par quel chemin la fiche est née — utile à la file de complétion.
enum SourceCreationMachine {
  terrain
  recensement
  import
  back_office
}

/// L'ORDRE D'INTERVENTION (lot 2, D84). Table métier de la première catégorie
/// de I1, de forme « parc » : c'est le PLANCHER mesuré, et RG-DRO-01 exclut la
/// clause de société seule — un compte portail lirait les interventions des
/// autres clients de sa propre société.
model Intervention {
  machines              InterventionMachine[]
  /// Ce que le compteur du technicien a mesuré (R5-02, D119).
  segments              SegmentTravail[]
  /// Les photos de l'intervention (BON-2) — des `Document` classe `client` ou
  /// `interne` comme les autres, jamais une seconde table de fichiers.
  documents             Document[]
  /// Les prestations RÉALISÉES sur cette intervention (BON-2), distinctes du
  /// catalogue `Prestation` qu'elles référencent.
  prestations_realisees InterventionPrestation[]
  /// La ou les signatures client (BON-2) — HISTORISÉES : une re-signature
  /// AJOUTE une ligne, elle n'en réécrit jamais une.
  signatures            InterventionSignature[]
  /// L'HISTORIQUE DES PAUSES (50-INTERVENTIONS-2, SAV-09) — voir
  /// `InterventionPause` : une ligne par suspension, jamais réécrite. Distinct
  /// des colonnes `motif_suspension`/`piece_attendue_ref`/`date_dispo_prevue`/
  /// `suspendue_le` ci-dessous, qui restent l'ÉTAT COURANT lu par d'autres
  /// écrans (le terrain, notamment).
  pauses                InterventionPause[]

  id         String @id @db.Uuid
  societe_id String @db.Uuid

  /// Attribué par le SERVEUR, séquentiellement par société (I10). NUL en
  /// attendant : **aucun code ne l'attribue aujourd'hui**, le compteur par
  /// société appartient à la synchronisation, comme pour `machine`.
  numero Int?

  /// Le couple du parc. **La MACHINE n'est plus ici** : elle vit dans
  /// `intervention_machine` depuis L2-08a, une visite pouvant en couvrir
  /// plusieurs (chapitre 7/M3). La garder en colonne « pour la principale »
  /// aurait fait deux écritures d'un même fait, et personne n'aurait su
  /// laquelle des deux sources fait foi (§9, 01/09).
  client_id String @db.Uuid
  site_id   String @db.Uuid

  /// DÉDUITE du site, jamais saisie (D56 : le site porte son rattachement).
  agence_id String @db.Uuid

  /// LA PANNE SIGNALÉE OU LE TRAVAIL DEMANDÉ (PARCOURS-1, 23/09/2026,
  /// arbitrage Alexis). Texte OBLIGATOIRE à la création — tenu par
  /// `schemaCreation`, jamais par une contrainte de base : les interventions
  /// nées avant ce lot n'ont rien à y écrire, et personne ne peut composer
  /// leur panne à leur place (même famille que D104).
  description String?

  /// LE CONTACT SUR PLACE (PARCOURS-1) — facultatif, même table que
  /// `demande.contact_id`. `Restrict` en suppression : un contact dont une
  /// intervention dépend ne s'efface pas.
  contact_id String? @db.Uuid

  /// LA RÉFÉRENCE CLIENT OU LE N° DE BON DE COMMANDE (PARCOURS-1) — texte
  /// libre, facultatif : le chapitre 10 ne pose aucune forme à ce jour.
  reference_client String?

  /// LA DEMANDE DONT CETTE INTERVENTION EST NÉE (68-DEMANDES-2, SAV-11).
  /// Facultative : une intervention peut naître directement, sans être passée
  /// par une demande. **Une demande peut donner PLUSIEURS interventions**
  /// (décision 4, une intervention = une machine) — ce lien vit donc ICI,
  /// sur l'intervention, jamais l'inverse, exactement comme le chapitre 11 le
  /// pose et comme `Demande` le dit dans son propre en-tête.
  demande_id String? @db.Uuid

  type     TypeIntervention
  priorite PrioriteIntervention @default(p3)
  statut   StatutIntervention   @default(a_planifier)

  date_planifiee    DateTime? @db.Date
  creneau_debut     DateTime?
  creneau_fin       DateTime?
  duree_estimee_min Int?

  /// Le technicien affecté — une IDENTITÉ, la table `technicien` du chapitre 11
  /// n'existant pas encore (CLAUDE.md §6, marque `(prévu)`).
  technicien_id String? @db.Uuid

  mode_valorisation ModeValorisation @default(temps_passe)

  /// LE SECOND AXE (D8), et il est NULLABLE — c'est une décision.
  ///
  /// D8 dit quand la valeur devient `a_facturer` ou `non_facturable` — à la
  /// clôture — et **ne dit pas ce qu'elle vaut avant**. Aucune des trois
  /// valeurs ne porte « pas encore décidé » : naître `a_facturer` ferait entrer
  /// toute intervention non clôturée dans la file de ce qui est à facturer ;
  /// naître `non_facturable` confondrait **« pas encore »** et **« jamais »**,
  /// et c'est précisément la valeur que les exemptions visent. *Une nouvelle
  /// ligne ne naît jamais sur la réponse négative* (doctrine d'arbitrage §3).
  ///
  /// **Elle n'est jamais écrite par l'application** : le déclencheur
  /// `intervention_facturation_a_la_cloture` la pose, et l'écrire des deux
  /// côtés serait deux lectures d'un même critère — dans l'endroit qui décide
  /// si un client est facturé. Une clôture sans réponse est refusée par
  /// `intervention_cloture_a_son_statut_facturation`.
  statut_facturation StatutFacturation?

  /// Le forfait de déplacement, DÉDUIT de la zone du site et jamais saisi à la
  /// main (D23, RG-TAR-06).
  forfait_deplacement_id String? @db.Uuid

  /// ── LES DEUX TEMPS (D120) ────────────────────────────────────────────────
  ///
  /// **Le compteur est la SEULE source du temps**, et il n'y a plus de saisie
  /// manuelle : elle se fait dans Winpro au moment de facturer, hors de
  /// CODIPLAN. Mais *un compteur oublié fausse les indicateurs*, et sans DEUX
  /// colonnes on ne peut pas voir l'écart — c'est toute la raison d'être de ce
  /// couple.
  ///
  /// LE TEMPS MESURÉ — la somme des segments FERMÉS de `segment_travail`,
  /// écrite par le compteur et **jamais modifiable** : un déclencheur refuse
  /// toute valeur qui ne soit pas cette somme. *Un temps qui se corrige n'est
  /// plus une mesure.*
  temps_mesure_min Int?

  /// LE TEMPS VALIDÉ — ce que le responsable ou l'ADV arrête à la validation.
  /// **C'est lui qui entre dans D83** — arrondi au quart d'heure supérieur puis
  /// plancher d'une heure — et lui seul : le temps mesuré ne se valorise pas
  /// tout seul.
  ///
  /// *Cette colonne s'appelait `temps_reel_min` et portait les deux rôles.* Le
  /// nom a changé avec la règle : elle n'est plus « le temps réellement passé »
  /// — celui-là est mesuré, et il est dans la colonne d'à côté —, elle est ce
  /// qu'un humain a validé. **Par défaut elle égale le temps mesuré** ; elle
  /// n'en diffère que si quelqu'un a corrigé, et on sait alors qui et quand.
  temps_valide_min Int?

  /// QUI a validé, et QUAND. *Une correction sans auteur ni date est une
  /// correction que personne n'assume* — et l'écart entre les deux temps ne se
  /// lit pas sans savoir d'où il vient. Les deux voyagent ensemble : une date
  /// sans auteur ne dit rien de plus qu'un horodatage de ligne.
  temps_valide_par String?   @db.Uuid
  temps_valide_le  DateTime? @db.Timestamptz(3)

  /// Le total hors taxes, ENTIER dans l'unité la plus fine, avec sa devise
  /// (I2, I3) — figé à la clôture, jamais recalculé après.
  montant_ht  BigInt?
  devise_code String?

  motif_annulation String?
  cloturee_le      DateTime?
  annulee_le       DateTime?

  /// LA SUSPENSION (L2-10, RG-INT-06). Le motif est EXIGÉ dès que le statut
  /// est `suspendue`, et refusé sinon — les deux sens, le second étant celui
  /// qu'on oublie.
  motif_suspension String?

  /// L'ATTENTE DE PIÈCE, et c'est `piece_attendue_ref` qui la DÉSIGNE : sa
  /// présence dit que la suspension attend une pièce. *Aucune énumération de
  /// motifs n'est inventée* — le chapitre 10 n'en pose pas, et fermer une
  /// énumération avant d'avoir tranché à qui l'on vend est une erreur que ce
  /// dépôt a déjà faite (§9, 20/08).
  ///
  /// RG-INT-06 exige les DEUX : *« pour une attente de pièce, la référence
  /// attendue **et** la date de disponibilité prévisionnelle »*. La base le
  /// tient, plutôt que de laisser une file d'attente sans horizon.
  piece_attendue_ref String?
  date_dispo_prevue  DateTime? @db.Date

  /// QUAND la suspension a commencé — l'ANCIENNETÉ s'en déduit, et rien
  /// d'autre ne la porte. `cloturee_le` et `annulee_le` existent pour la même
  /// raison : la table date chacun de ses états d'arrêt.
  ///
  /// Sans elle, l'ancienneté demandée par L2-10 et l'alerte « en attente de
  /// pièce depuis > 30 j » du chapitre 16.1 devraient se lire dans le journal
  /// d'audit — *une trace n'est pas un index*.
  suspendue_le DateTime?

  /// LE COMMENTAIRE DU TECHNICIEN (BON-2) — ce qui a été constaté ou fait,
  /// dans ses mots. Saisi sur le TERRAIN, jamais au back-office (I4, I5) :
  /// c'est lui qui est devant la machine et devant le client. `NULL` tant que
  /// rien n'a été écrit — jamais une chaîne vide, qui se confondrait avec un
  /// commentaire réellement vide.
  commentaire_technicien String?

  /// LA SUITE À DONNER (BON-2) — ce qu'il reste à faire, ou à surveiller,
  /// entre deux visites. Même régime que `commentaire_technicien` : terrain
  /// seul, `NULL` tant que rien n'a été écrit.
  suite_a_donner String?

  /// LA NOTE INTERNE (50-INTERVENTIONS-2) — visible et modifiable par les
  /// rôles BACK-OFFICE seulement. **Régime INVERSE de
  /// `commentaire_technicien`/`suite_a_donner`** : jamais sur le terrain, le
  /// bon imprimable, le portail ni un courriel. `NULL` tant que rien n'a été
  /// écrit.
  note_interne String?

  /// LE BADGE « NOUVEAU », côté technicien (AVERTISSEMENTS-1, 24/09/2026).
  /// `NULL` tant que le technicien AFFECTÉ n'a pas ouvert sa fiche terrain —
  /// c'est alors, et alors seulement, que `/terrain/[id]` la pose à `now()`.
  /// Une ouverture par un autre rôle (l'ADV, sur `/interventions/[id]`) ne la
  /// touche pas : le badge dit ce que LE TECHNICIEN a vu, rien d'autre.
  ///
  /// Repasse à `NULL` à CHAQUE (RÉ)AFFECTATION d'un technicien — par
  /// `deplacerIntervention` ou `affecterTechnicien` — pour que le badge
  /// reflète toujours l'affectation courante et non une lecture faite par un
  /// technicien qui n'est plus celui d'aujourd'hui.
  vue_technicien_le DateTime? @db.Timestamptz(3)

  cree_le    DateTime @default(now())
  modifie_le DateTime @updatedAt

  societe          Societe          @relation(fields: [societe_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  client           Client           @relation(fields: [societe_id, client_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)
  site             Site             @relation(fields: [societe_id, site_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)
  agence           Agence           @relation(fields: [societe_id, agence_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)
  /// Chaîné sur le CLIENT, pas seulement sur la société — même forme que
  /// `demande.contact_id` : un contact d'un autre client ne peut pas être
  /// désigné. `contact_id` nullable, `MATCH SIMPLE` : « pas de contact » est
  /// le seul état que la nullité produit (§9, 23/08).
  contact          Contact?         @relation(fields: [societe_id, client_id, contact_id], references: [societe_id, client_id, id], onDelete: Restrict, onUpdate: Restrict)
  forfait          Forfait?         @relation(fields: [societe_id, forfait_deplacement_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)
  devise           Devise?          @relation(fields: [devise_code], references: [code], onDelete: Restrict, onUpdate: Restrict)
  observations_vgp VgpObservation[]
  /// LA DEMANDE D'ORIGINE (68-DEMANDES-2). `Restrict` en suppression, comme
  /// tous les autres liens de cette table : une demande dont une intervention
  /// dépend ne s'efface pas.
  demande          Demande?         @relation(fields: [societe_id, demande_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([societe_id, id])
  @@unique([societe_id, numero])
  @@index([societe_id, date_planifiee])
  @@index([societe_id, technicien_id, date_planifiee])
  @@index([societe_id, client_id])
  @@index([societe_id, site_id])
  @@index([societe_id, demande_id])
  @@map("intervention")
}

/// La nature de l'intervention (chapitre 11.2).
enum TypeIntervention {
  preventif_contrat
  preventif_hors_contrat
  curatif
  installation
  garantie
  controle_reglementaire
  expertise
  reprise
  recensement
}

/// Le niveau d'urgence, qui pilote le SLA (chapitre 10, RG-SLA).
enum PrioriteIntervention {
  p1
  p2
  p3
  p4
}

/// Le cycle de vie, et son ORDRE DE PRÉSÉANCE est celui de I5 :
/// `annulee` > `cloturee` > `terminee` > `en_cours` > `suspendue` > les statuts
/// de planification. Les codes couleur de l'annexe D sont promus au rang de
/// règle (CLAUDE.md §1) et vivent dans `lib/i18n/fr.ts`.
enum StatutIntervention {
  a_planifier
  planifiee
  affectee
  en_cours
  suspendue
  terminee
  cloturee
  annulee
}

/// LE SECOND AXE DE L'INTERVENTION, distinct de son avancement (D8).
///
/// *« Le statut d'avancement et le statut de facturation sont deux colonnes
/// distinctes. Le modèle de données a raison, le diagramme a tort. »* `statut`
/// s'arrête à `cloturee` ; `a_facturer` et `facturee` vivent ICI.
///
/// **Trois valeurs, celles du chapitre 11, et pas une de plus.** `NULL` en
/// porte une quatrième qui n'est pas dans l'énumération : *« la question ne
/// s'est pas encore posée »*. Ajouter une quatrième VALEUR serait un changement
/// de schéma touchant les statuts d'intervention, que le §8 range parmi les
/// points d'arrêt.
enum StatutFacturation {
  non_facturable
  a_facturer
  facturee
}

/// Comment l'intervention se valorise (RG-TAR-05, D83).
enum ModeValorisation {
  forfait
  temps_passe
  forfait_plus_heures
}

/// LA DEMANDE D'INTERVENTION — le point d'entrée du flux (lot 2, L2-06).
///
/// Table métier de la première catégorie de I1, forme « parc » (D102) : société
/// **ET** `app.client_id` **ET** `app.perimetre_sites`. La clause de société
/// seule est exclue par RG-DRO-01 — *un client n'accède qu'aux données de son
/// propre périmètre* —, et P5 du chapitre 9 fait déposer une demande depuis le
/// portail : c'est la table même où un compte de portail écrit.
///
/// **Elle ne porte AUCUN lien vers l'intervention qu'elle devient.** Le
/// chapitre 11 met `demande_id` sur `intervention`, et l'écrire des deux côtés
/// serait deux écritures d'un même fait, qui divergent en silence (§9, 01/09).
model Demande {
  id         String @id @db.Uuid
  societe_id String @db.Uuid

  /// Attribué par le SERVEUR, séquentiellement par société (I10, DEM-AAAA-NNNNN
  /// à l'annexe). NUL en attendant : **aucun code ne l'attribue aujourd'hui**,
  /// exactement comme sur `machine` et `intervention`.
  numero Int?

  source SourceDemande

  /// Le triplet du parc. `machine_id` est FACULTATIF — le chapitre 7 écrit
  /// « machine concernée **ou déclarée inconnue** » —, `site_id` ne l'est pas :
  /// il est la colonne de périmètre, et une demande sans site serait une
  /// demande qu'aucun compte de portail restreint ne pourrait lire.
  client_id  String  @db.Uuid
  site_id    String  @db.Uuid
  machine_id String? @db.Uuid

  /// DÉDUITE du site, jamais saisie (D56) — c'est elle qui décide du calendrier
  /// de référence de l'accusé de réception (D13, I7).
  agence_id String @db.Uuid

  /// Le contact à l'origine de la demande. Facultatif : une demande née d'une
  /// échéance contractuelle ou d'un seuil de compteur n'a personne au bout du
  /// fil.
  contact_id String? @db.Uuid

  description     String
  urgence         PrioriteIntervention @default(p3)
  machine_arretee Boolean              @default(false)
  date_souhaitee  DateTime?            @db.Date

  statut StatutDemande @default(nouvelle)

  /// L'instant du DÉPÔT, et l'instant où le compteur des 30 minutes COMMENCE —
  /// deux colonnes, parce qu'ils diffèrent (D13 : *une demande déposée un
  /// dimanche à 22 h déclenche son compteur à l'ouverture du lundi*).
  ///
  /// Le départ est **MATÉRIALISÉ et jamais recalculé** : il dépend du
  /// calendrier de l'agence tel qu'il était au dépôt, et un calendrier se
  /// modifie — déclarer un férié travaillé ferait reculer, des mois plus tard,
  /// le départ d'un compteur déjà consommé, **sans qu'aucune écriture ne le
  /// dise**. C'est le motif de D85 hors du cloisonnement : quand un fait
  /// dépend du temps, une colonne le porte et l'horloge ne touche que le
  /// travail qui l'écrit.
  depose_le          DateTime
  compteur_accuse_le DateTime

  /// L'instant où l'accusé a RÉELLEMENT été donné. NUL tant qu'il ne l'a pas
  /// été — et « nul » ne veut pas dire « hors délai » : c'est `lib/demandes`
  /// qui distingue les trois états, jamais un booléen (doctrine §3).
  accuse_le DateTime?

  /// La clôture sans suite, et elle mesure le service rendu à distance
  /// (chapitre 7/M3). Le motif est EXIGÉ quand elle a lieu et REFUSÉ sinon —
  /// les deux sens, le second étant celui qu'on oublie.
  motif_cloture MotifClotureDemande?
  close_le      DateTime?

  cree_le    DateTime @default(now())
  modifie_le DateTime @updatedAt

  societe Societe  @relation(fields: [societe_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  client  Client   @relation(fields: [societe_id, client_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)
  site    Site     @relation(fields: [societe_id, site_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)
  machine Machine? @relation(fields: [societe_id, machine_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)
  agence  Agence   @relation(fields: [societe_id, agence_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)
  /// Le contact est chaîné sur le CLIENT, pas seulement sur la société : un
  /// contact d'un autre client ne peut pas être désigné. `contact_id` étant
  /// nullable, PostgreSQL ne contrôle pas la clé quand il vaut NULL
  /// (`MATCH SIMPLE`, §9 du 23/08) — et c'est ici le comportement VOULU, les
  /// deux autres colonnes étant NOT NULL : « pas de contact » est le seul état
  /// que la nullité produit, jamais une ligne à moitié vérifiée.
  contact Contact? @relation(fields: [societe_id, client_id, contact_id], references: [societe_id, client_id, id], onDelete: Restrict, onUpdate: Restrict)
  /// Les interventions NÉES de cette demande (68-DEMANDES-2) — zéro, une, ou
  /// plusieurs : une demande peut donner plusieurs interventions (décision 4,
  /// une intervention = une machine). Le lien vit sur `intervention.demande_id`
  /// ; ce champ n'est que sa face inverse, jamais une seconde écriture.
  interventions Intervention[]

  @@unique([societe_id, id])
  @@unique([societe_id, numero])
  @@index([societe_id, statut])
  @@index([societe_id, client_id])
  @@index([societe_id, site_id])
  @@map("demande")
}

/// LES MACHINES D'UNE INTERVENTION — une ligne par machine traitée (L2-08a).
///
/// > *« Une visite peut couvrir plusieurs machines : plusieurs lignes machine,
/// > chacune avec sa checklist et son état de sortie, un seul déplacement, un
/// > seul rapport. C'est le format naturel des visites de recensement et des
/// > visites préventives de contrat. »* (chapitre 7/M3)
///
/// **Elle REMPLACE `intervention.machine_id`**, elle ne s'y ajoute pas : deux
/// écritures d'un même fait divergent en silence (§9, 01/09), et « la machine
/// principale, plus les autres » aurait laissé chaque lecteur choisir laquelle
/// des deux sources est la vérité.
///
/// Forme de politique « filiation » (D103) : *une fille est visible si son
/// parent l'est.* La sous-requête est soumise à la politique d'`intervention`,
/// de forme « parc » — les trois filtres s'y propagent sans qu'aucun soit
/// réécrit ici.
///
/// **Ce qu'elle NE porte PAS, et c'est délibéré :** diagnostic, travaux, état de
/// sortie, relevé de compteur, résultat de checklist. Le chapitre 11 les nomme,
/// et ils sont SAISIS SUR LE TERRAIN — au lot 3, avec la synchronisation
/// hors-ligne. *Une colonne posée d'avance est une décision de personne.*
model InterventionMachine {
  id         String @id @db.Uuid
  societe_id String @db.Uuid

  intervention_id String @db.Uuid
  machine_id      String @db.Uuid

  cree_le    DateTime @default(now())
  modifie_le DateTime @updatedAt

  societe      Societe      @relation(fields: [societe_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// `ON DELETE CASCADE`, et c'est la SEULE de ce dépôt. Une ligne de rattachement
  /// n'a aucun sens sans son intervention — à la différence d'une trace, qu'on
  /// garde. Les deux actions sont dites, comme toute clé nouvelle (§9, 24/08).
  intervention Intervention @relation(fields: [societe_id, intervention_id], references: [societe_id, id], onDelete: Cascade, onUpdate: Restrict)
  machine      Machine      @relation(fields: [societe_id, machine_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([societe_id, id])
  /// La même machine ne se rattache pas deux fois à la même visite : ce serait
  /// deux checklists pour un seul matériel, et personne ne saurait laquelle
  /// fait foi.
  @@unique([intervention_id, machine_id])
  /// UNE INTERVENTION NE PORTE QU'UNE MACHINE AU PLUS (PARCOURS-1, 23/09/2026,
  /// arbitrage Alexis). Posée VALIDÉE, et non `NOT VALID` : la migration qui
  /// l'ajoute vérifie d'abord qu'aucune ligne existante ne l'enfreint, et
  /// ÉCHOUE plutôt que de laisser un trou — voir la migration pour le motif.
  @@unique([intervention_id])
  @@index([societe_id, machine_id])
  @@map("intervention_machine")
}

/// LES PRESTATIONS RÉALISÉES SUR UNE INTERVENTION (BON-2, ticket 17-BON-2).
///
/// **Un simple rattachement, pas une ligne de facturation.** La question posée
/// par le bon est « qu'est-ce qui a été fait », pas « combien de temps chaque
/// prestation a-t-elle pris » — ce dernier existe déjà, agrégé, sur
/// `segment_travail`/`intervention.temps_mesure_min`. Ajouter une durée PAR
/// PRESTATION serait une donnée que rien ne demande encore et qui pourrait
/// diverger du temps mesuré (§9, 01/09) : *une prestation porte une durée
/// STANDARD dans son catalogue (`Prestation.duree_standard_min`), jamais un
/// tarif (D109)*, et ce lot ne lui en invente pas une seconde, propre à
/// l'intervention.
///
/// **Condition de réouverture, écrite plutôt que devinée** : le jour où une
/// intervention doit facturer plusieurs prestations avec des durées propres et
/// distinctes du temps mesuré global, cette table portera sa propre colonne de
/// durée — et ce jour-là seulement.
///
/// Forme de politique « filiation » (D103, comme `intervention_machine`) :
/// une fille est visible si son parent l'est. Aucune clause de société ni de
/// visibilité sur `prestation` n'est ajoutée : c'est la clé étrangère
/// composite qui empêche la ligne de dériver de leurs sociétés respectives.
model InterventionPrestation {
  id         String @id @db.Uuid
  societe_id String @db.Uuid

  intervention_id String @db.Uuid
  prestation_id   String @db.Uuid

  cree_le DateTime @default(now())

  societe      Societe      @relation(fields: [societe_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// `ON DELETE CASCADE`, comme `intervention_machine` : une ligne de
  /// rattachement n'a aucun sens sans son intervention.
  intervention Intervention @relation(fields: [societe_id, intervention_id], references: [societe_id, id], onDelete: Cascade, onUpdate: Restrict)
  prestation   Prestation   @relation(fields: [societe_id, prestation_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)

  /// La même prestation ne se déclare pas deux fois réalisée sur la même
  /// visite.
  @@unique([intervention_id, prestation_id])
  @@index([societe_id, prestation_id])
  @@map("intervention_prestation")
}

/// LA SIGNATURE CLIENT (BON-2, ticket 17-BON-2) — une PREUVE, pas un réglage.
///
/// **HISTORISÉE, jamais réécrite** — le même principe que `taux_horaire`
/// (RG-TAR-04) appliqué à une preuve plutôt qu'à un tarif : si le client
/// re-signe, l'ancienne signature reste, datée, et une nouvelle ligne
/// s'ajoute. *Une preuve qui se remplace en silence cesse d'en être une.*
/// C'est une discipline du DÉPÔT (`lib/interventions/terrain-saisie.ts`
/// n'expose aucune fonction de modification ou de suppression) **doublée par
/// la base** : ni `UPDATE` ni `DELETE` ne sont accordés au rôle applicatif —
/// même raisonnement que `journal_audit` (I8), transposé à une seule table
/// plutôt qu'au journal entier.
///
/// **Ajouter une signature n'est jamais refusé par le statut de
/// l'intervention** — pas même `cloturee` ou `annulee`. I5 garantit que le
/// travail terrain n'est jamais perdu ; borner l'ajout par un statut lu au
/// moment de l'écriture referait, sur une preuve, l'erreur qu'I5 interdit sur
/// un segment de travail.
///
/// Forme de politique « filiation » (comme `intervention_prestation`) : une
/// fille est visible si son parent l'est.
model InterventionSignature {
  id         String @id @db.Uuid
  societe_id String @db.Uuid

  intervention_id String @db.Uuid

  /// L'image de la signature, encodée en `data:image/png;base64,...` — un
  /// tracé de canevas, jamais un fichier : la signature n'a pas de nom, pas de
  /// type MIME propre à discuter, et passer par `Document` pour un tracé de
  /// quelques kilo-octets aurait fait porter à un module de fichiers une
  /// donnée qui n'en est pas un.
  image_base64 String

  cree_le DateTime @default(now())

  societe      Societe      @relation(fields: [societe_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  intervention Intervention @relation(fields: [societe_id, intervention_id], references: [societe_id, id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([societe_id, id])
  @@index([societe_id, intervention_id])
  @@map("intervention_signature")
}

/// L'HISTORIQUE DES PAUSES D'UNE INTERVENTION (50-INTERVENTIONS-2, SAV-09).
///
/// **Ce que `intervention.motif_suspension` / `piece_attendue_ref` /
/// `date_dispo_prevue` / `suspendue_le` ne peuvent pas dire** : ces quatre
/// colonnes sont RÉÉCRITES à chaque suspension (L2-10) — la seconde efface la
/// première, et deux pauses successives (pièce en commande, puis une seconde)
/// ne restent pas lisibles. Cette table ne réécrit JAMAIS une ligne : une
/// suspension OUVRE une ligne (`fin` NULL), une reprise la FERME (`fin`
/// posée) — jamais l'inverse.
///
/// **Les colonnes existantes de `intervention` restent** — lues par d'autres
/// écrans (le terrain, notamment) — et continuent d'être écrites dans la
/// MÊME transaction que cette table, par `suspendreIntervention`/
/// `reprendreIntervention` : les deux couples décrivent le MÊME événement,
/// jamais l'un sans l'autre. Cette table est l'HISTORIQUE, pas un
/// remplacement.
///
/// Forme de politique « filiation » (D103), sur le modèle exact
/// d'`intervention_prestation` : une fille est visible si son parent l'est.
///
/// `ouvert_par` et `fermee_par` sont NULLABLES — et c'est délibéré. La
/// REPRISE DE DONNÉES de la migration qui crée cette table ne connaît
/// l'auteur d'AUCUNE suspension déjà en base : aucune colonne ne l'a jamais
/// porté, et inventer une valeur serait la faute que le §8 du `CLAUDE.md`
/// interdit — ne jamais inventer une valeur par défaut. Toute pause née après
/// ce lot les porte.
model InterventionPause {
  id         String @id @db.Uuid
  societe_id String @db.Uuid

  intervention_id String @db.Uuid

  /// L'instant d'OUVERTURE — daté dans le fuseau de l'agence (L0-08), comme
  /// `intervention.suspendue_le`, jamais saisi.
  debut DateTime @db.Timestamptz(3)
  /// `NULL` = la pause est en cours. Jamais « on ne sait pas » : la base
  /// n'autorise qu'UNE pause ouverte par intervention (index partiel).
  fin DateTime? @db.Timestamptz(3)

  motif String

  /// L'ATTENTE DE PIÈCE — même régime que `intervention.piece_attendue_ref`
  /// (RG-INT-06) : la référence et la date de disponibilité voyagent
  /// ENSEMBLE, ou pas du tout.
  piece_attendue_ref String?
  date_dispo_prevue  DateTime? @db.Date

  ouvert_par String? @db.Uuid
  fermee_par String? @db.Uuid

  cree_le DateTime @default(now()) @db.Timestamptz(3)

  societe      Societe      @relation(fields: [societe_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// `ON DELETE CASCADE`, comme `intervention_prestation` : une ligne
  /// d'historique n'a aucun sens sans son intervention.
  intervention Intervention @relation(fields: [societe_id, intervention_id], references: [societe_id, id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([societe_id, id])
  @@index([societe_id, intervention_id, debut])
  @@map("intervention_pause")
}

/// D'où vient la demande (chapitre 7/M3). Six sources, et elles ne se
/// équivalent pas : `portail` est la seule qu'un compte de client écrit.
enum SourceDemande {
  appel
  portail
  email
  echeance_contrat
  seuil_compteur
  detection_technicien
}

/// Le cycle de vie d'une demande (L2-06). Quatre statuts, et deux fins : elle
/// devient une intervention, ou elle est close sans suite AVEC son motif.
enum StatutDemande {
  nouvelle
  qualifiee
  transformee
  close_sans_suite
}

/// Pourquoi une demande se clôt sans intervention. *Cette information est
/// conservée : elle mesure le service rendu à distance* (chapitre 7/M3).
enum MotifClotureDemande {
  resolue_telephone
  hors_perimetre
  refus_client
  doublon
}

/// D'OÙ VIENT CE QU'ON NOUS A DIT (D114).
///
/// **Un rapport reçu de l'organisme, une vignette photographiée par un
/// technicien et une parole du client au téléphone n'ont pas la même valeur le
/// jour d'un contrôle.** Et l'origine **ne se reconstitue pas après coup** : une
/// ligne écrite sans elle est une ligne dont personne ne saura jamais d'où elle
/// vient.
///
/// **Énumération CLOSE en base, jamais un champ libre** : *un champ libre sur
/// une question de valeur probante produit autant de graphies que de saisies, et
/// aucune ne se compte.*
///
/// **CES QUATRE VALEURS SONT UNE PROPOSITION, et D114 le dit** : elles sont du
/// vocabulaire d'exploitation, et le §1 du protocole le réserve à Alexis. La
/// table naît avec la colonne ; la liste se complète par `ALTER TYPE … ADD
/// VALUE`, qui ne coûte rien. *Ce qui aurait coûté cher est de ne pas avoir la
/// colonne.*
enum OrigineInformationVgp {
  /// Le rapport, reçu directement de l'organisme agréé. La valeur probante la
  /// plus forte : nous tenons la pièce, et de sa source.
  rapport_organisme

  /// Le même document, transmis par le CLIENT. La pièce est là, sa chaîne de
  /// transmission ne l'est pas — et c'est exactement ce que D88 nomme : *les
  /// VGP sont commandées par les clients.*
  rapport_transmis_client

  /// La vignette apposée sur la machine, vue et photographiée sur site. Elle
  /// dit qu'une vérification a eu lieu et à quelle date ; elle ne dit pas ce
  /// qu'elle a conclu.
  vignette_constatee

  /// Ce que le client nous a dit, sans pièce. *La valeur la plus faible, et
  /// c'est pour la distinguer des trois autres que cette colonne existe.*
  declaration_client
}

/// CE QU'ON NOUS A DIT D'UNE VÉRIFICATION PÉRIODIQUE (lot 9, D88, D114).
///
/// **CODIPLAN N'AFFIRME JAMAIS LA CONFORMITÉ** : cette table enregistre ce
/// qu'un organisme agréé a écrit, et le seul calcul du produit est une DATE
/// (L9-01). Aucune colonne ne porte un verdict.
///
/// Forme de politique **« filiation »**, parent `machine` — *une fille est
/// visible si son parent l'est*, et c'est `site_habilitation_requise` qui a
/// ouvert cette forme avec un parent qui n'est pas une intervention. **Aucune
/// clause de société n'y est ajoutée** : elle serait une seconde source du même
/// fait, et c'est la clé étrangère composite qui empêche une fille de dériver
/// de la société de son parent.
model VgpVerification {
  id         String @id @db.Uuid
  societe_id String @db.Uuid

  /// LE PARENT. C'est lui qui décide qui a le droit de voir cette ligne.
  machine_id String @db.Uuid

  /// LA DATE DE LA VÉRIFICATION — un jour, pas un instant : un organisme
  /// intervient un jour donné, et l'heure n'est ni connue ni utile.
  date_verification DateTime @db.Date

  /// QUI L'A DITE. Texte libre : les organismes agréés ne sont pas une
  /// énumération que ce produit puisse fermer — ils diffèrent par territoire,
  /// et la solution sera vendue ailleurs (la leçon de la périodicité, L9-05).
  organisme String

  /// La référence du rapport, telle qu'elle figure dessus. NULLE quand
  /// l'information ne vient pas d'un rapport — une vignette n'en porte pas.
  reference_rapport String?

  /// D'OÙ VIENT L'INFORMATION (D114). Obligatoire, et sans valeur par défaut :
  /// *une origine par défaut serait une valeur probante inventée.*
  origine OrigineInformationVgp

  /// OÙ SONT LES OCTETS, quand on les a — un `document` de classe `client`
  /// (D88 §9). FACULTATIF : on peut savoir qu'une vérification a eu lieu sans
  /// détenir la pièce, et c'est même le cas d'une vignette constatée.
  document_id String? @db.Uuid

  cree_le    DateTime @default(now())
  modifie_le DateTime @updatedAt

  societe      Societe          @relation(fields: [societe_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  machine      Machine          @relation(fields: [societe_id, machine_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)
  document     Document?        @relation(fields: [societe_id, document_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)
  observations VgpObservation[]

  @@unique([societe_id, id])
  @@index([societe_id, machine_id, date_verification(sort: Desc)])
  @@map("vgp_verification")
}

/// UNE OBSERVATION D'ORGANISME — un travail à faire, daté, sur une machine
/// identifiée (D88 §10).
///
/// > *« C'est le seul point où ce lot alimente le planning, et c'est celui qui
/// > rapporte de l'argent. »*
///
/// **Elle a exactement la forme d'une intervention `a_planifier`**, et
/// `intervention_id` dit celle qu'elle a engendrée. NULLE tant que personne ne
/// l'a planifiée : *une observation non traitée est l'état qui compte*, et la
/// confondre avec une observation traitée ferait disparaître du travail dû.
///
/// Forme **« filiation »**, parent `vgp_verification` — qui est elle-même une
/// fille de `machine`. *L'adossement se chaîne, et c'est ce qui fait qu'aucune
/// clause de société n'est écrite nulle part dans cette branche.*
model VgpObservation {
  id              String @id @db.Uuid
  societe_id      String @db.Uuid
  verification_id String @db.Uuid

  /// CE QUE L'ORGANISME A ÉCRIT, mot pour mot. Texte libre, et il le restera :
  /// *une énumération d'observations serait une classification que CODIPLAN
  /// n'a pas le droit de faire* — il rapporte, il ne qualifie pas.
  libelle String

  /// L'intervention engendrée, NULLE tant qu'il n'y en a pas.
  intervention_id String? @db.Uuid

  cree_le    DateTime @default(now())
  modifie_le DateTime @updatedAt

  societe      Societe         @relation(fields: [societe_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  verification VgpVerification @relation(fields: [societe_id, verification_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)
  intervention Intervention?   @relation(fields: [societe_id, intervention_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([societe_id, verification_id])
  @@map("vgp_observation")
}

/// UNE CAMPAGNE DE MISE EN CONFORMITÉ DU REGISTRE (L9-08, D88 §8).
///
/// > **Faire passer une famille de « non soumise » à « soumise » n'ouvre PAS
/// > deux cents alertes : cela ouvre UNE CAMPAGNE DATÉE avec un compteur qui
/// > descend.**
///
/// *Un gardien dont le taux de fausses alertes conduit à ne plus le lire coûte
/// plus qu'il ne rapporte* (§9, 11/09) — et deux cents alertes le jour d'une
/// déclaration sont la panne par le bruit, la plus sûre de toutes.
///
/// **Le compteur n'est PAS une colonne, et c'est décidé** : il se DÉRIVE des
/// machines de la famille qui n'ont reçu aucune information depuis l'ouverture.
/// *Un compteur stocké se désynchronise en silence, et un compteur figé est
/// pire qu'une alerte de trop : il a l'air de mesurer.*
model VgpCampagne {
  id         String @id @db.Uuid
  societe_id String @db.Uuid

  /// LA FAMILLE dont la déclaration a ouvert la campagne.
  famille_id String @db.Uuid

  /// LE JOUR DE L'OUVERTURE. C'est lui qui borne ce que le compteur regarde :
  /// une information reçue AVANT ne solde pas une campagne ouverte APRÈS.
  ouverte_le DateTime @db.Date

  /// LE JOUR OÙ ELLE A ÉTÉ CLOSE, à la main. NULLE tant qu'elle court.
  /// *Elle ne se ferme pas toute seule quand le compteur atteint zéro* : une
  /// campagne close est une décision, et le compteur peut remonter — une
  /// machine neuve entre dans la famille.
  close_le DateTime? @db.Date

  cree_le    DateTime @default(now())
  modifie_le DateTime @updatedAt

  societe Societe         @relation(fields: [societe_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  famille FamilleMateriel @relation(fields: [societe_id, famille_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([societe_id, famille_id])
  @@map("vgp_campagne")
}

/// LE CATALOGUE DES PRESTATIONS (L1-12 ; D109, D113).
///
/// **UNE PRESTATION PORTE UNE DURÉE, JAMAIS UN TAUX** (D109). *Une facture ne
/// change pas quand un tarif change* — RG-TAR-04, et `lib/tarification/` tout
/// entier. **Deux endroits qui portent un prix, c'est une préséance à inventer
/// et une seconde historisation à tenir, pour rien.** Aucune colonne de montant
/// ici, et un gardien le refuse.
///
/// **ET ELLE NE DÉSIGNE AUCUN FORFAIT** (D113, 12/09/2026). Le pont de D109
/// vaut au sens où l'INTERVENTION reçoit le forfait par les trois axes de
/// RG-TAR-06, jamais au sens d'une clé étrangère portée par le catalogue : une
/// telle colonne aurait fait naître la question « et si le forfait désigné ne
/// s'applique pas à la zone ? », qu'il aurait fallu arbitrer d'avance.
///
/// **Propre à chaque société**, et la raison n'est pas technique : *une durée
/// standard et une checklist décrivent la façon de travailler d'une entreprise
/// et le niveau de ses techniciens.* Le jour où CODIPLAN est vendu à un
/// concurrent de CODIMA, il n'héritera pas de ce catalogue.
model Prestation {
  id         String @id @db.Uuid
  societe_id String @db.Uuid

  code    String
  libelle String

  /// La famille visée, FACULTATIVE : un déplacement, un diagnostic ou une
  /// formation ne visent aucune famille de matériel. Chaînée sur le COUPLE
  /// (société, famille) — sans la société dans la clé, le verrou serait muet là
  /// où le cloisonnement doit mordre.
  famille_id String? @db.Uuid

  /// LA DURÉE STANDARD, en minutes. NULLE quand personne ne l'a estimée — ce
  /// qui est l'état ordinaire d'un catalogue qu'on remplit, et qui ne se
  /// confond pas avec zéro, lequel dirait « instantané ». Strictement positive
  /// par contrainte.
  duree_standard_min Int?

  /// La checklist type, en texte LIBRE : le chapitre 10 ne pose aucune
  /// structure, et en inventer une ici la figerait pour toutes les sociétés
  /// avant que quiconque en ait écrit une seule.
  checklist_type String?

  actif Boolean @default(true)

  cree_le    DateTime @default(now())
  modifie_le DateTime @updatedAt

  societe      Societe                  @relation(fields: [societe_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  famille      FamilleMateriel?         @relation(fields: [societe_id, famille_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)
  /// Les fois où cette prestation a été déclarée réalisée (BON-2).
  realisations InterventionPrestation[]

  @@unique([societe_id, code])
  /// Cible du chaînage composite que `intervention_prestation` pose (BON-2).
  @@unique([societe_id, id])
  @@index([societe_id, famille_id])
  @@map("prestation")
}

model Forfait {
  interventions Intervention[]

  id         String @id @db.Uuid
  societe_id String @db.Uuid

  code    String
  libelle String
  type    TypeForfait

  /// L'ORDRE D'APPLICATION quand plusieurs forfaits conviennent (D86). Le PLUS
  /// PETIT l'emporte. Explicite, stocké, modifiable — jamais l'ordre
  /// d'insertion ni l'identifiant : deux interventions identiques se
  /// factureraient sinon différemment selon la minute d'une saisie passée.
  ///
  /// **L'égalité de rang est un état INTERDIT, refusé par la base** — voir
  /// l'unicité composite plus bas. Elle porte sur `(societe_id, type, rang)` :
  /// un déplacement n'est jamais en concurrence avec une prestation, et un
  /// rang unique sur tout le catalogue obligerait à renuméroter des lignes
  /// sans rapport.
  rang Int

  /// Entier dans l'unité la plus fine, avec sa devise (I2, I3). Le chapitre 11
  /// l'écrit `numeric` ; la décision du 08/09/2026 l'amende.
  montant_mineur BigInt
  devise_code    String

  /// Les trois axes de RG-TAR-06. « Sans condition sur cet axe » ne veut
  /// JAMAIS dire « aucune valeur ne convient ».
  ///
  /// **EN BASE, c'est `NULL` pour les trois** — et le tableau VIDE est REFUSÉ :
  /// `condition_multivaluee_valide` n'admet que `NULL` ou un ensemble non vide
  /// (`forfait_zones_non_vides`). **C'est PRISMA qui ne sait pas déclarer une
  /// liste scalaire nullable**, et qui rend `[]` à la LECTURE d'un `NULL`.
  ///
  /// La note précédente disait l'inverse — *« une liste scalaire PostgreSQL
  /// n'étant pas nullable, l'absence de condition y est le tableau VIDE »* —
  /// et confondait une limite de l'ORM avec une propriété de la base (mesuré
  /// le 11/09/2026 : `'{}'` refusé en 23514, `NULL` accepté).
  ///
  /// **Conséquence pour qui écrira un forfait** : envoyer `null`, jamais `[]`.
  /// Écrire `[]` par Prisma est refusé par la base.
  zone_geo          String[]
  famille_id        String?  @db.Uuid
  /// INERTE : les types d'intervention n'existent nulle part encore.
  type_intervention String[]

  cumulable_temps Boolean
  actif           Boolean @default(true)

  societe Societe          @relation(fields: [societe_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  devise  Devise           @relation(fields: [devise_code], references: [code], onDelete: Restrict, onUpdate: Restrict)
  famille FamilleMateriel? @relation(fields: [societe_id, famille_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([societe_id, code])
  /// L'ordre d'application est TOTAL par nature de forfait (D86) : deux
  /// forfaits de même type ne peuvent pas partager un rang. C'est ce qui rend
  /// « le premier applicable l'emporte » indépendant de l'ordre des lignes.
  @@unique([societe_id, type, rang])
  /// Chaînage composite : une intervention ne peut porter que le forfait de
  /// SA société — le couple est ce qui le garantit en base (D48, même forme).
  @@unique([societe_id, id])
  @@index([societe_id, actif])
  @@map("forfait")
}

/// Taux horaire d'une société, HISTORISÉ par date d'effet (ticket L1-07,
/// RG-TAR-04).
///
/// *Une intervention se facture au taux en vigueur à SA date, pas au taux
/// d'aujourd'hui. Une facture qui change quand le tarif change est une facture
/// fausse.* Une colonne ne peut pas porter cela : elle porte la valeur de
/// maintenant. Il faut une ligne par date d'effet, et la lecture choisit la plus
/// récente qui ne soit pas postérieure à la date cherchée.
model TauxHoraire {
  id         String @id @db.Uuid
  societe_id String @db.Uuid

  /// Le jour à partir duquel ce taux s'applique. Une DATE et non un instant :
  /// un tarif change un jour, pas à une heure.
  date_effet DateTime @db.Date

  /// Valeur ENTIÈRE, dans l'unité la plus fine de la devise — la forme de
  /// `Montant` dans `lib/money` : 7000 pour 7 000 XPF, 6500 pour 65,00 EUR.
  /// Jamais un flottant : les décimales sont une propriété de la devise (I3).
  montant_mineur BigInt

  /// Il accompagne le montant, toujours (I2) : un taux lu sans sa devise est un
  /// nombre, et un nombre n'est pas un montant. Un déclencheur refuse qu'il
  /// s'écarte de celui de sa société — la redondance est un CONSTAT contraint,
  /// pas une seconde source.
  devise_code String

  societe Societe @relation(fields: [societe_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  devise  Devise  @relation(fields: [devise_code], references: [code], onDelete: Restrict, onUpdate: Restrict)

  @@unique([societe_id, date_effet])
  @@index([societe_id, date_effet(sort: Desc)])
  @@map("taux_horaire")
}

/// Famille de matériel suivie par une société (ticket L1-05).
///
/// **Table MÉTIER cloisonnée, et non référentiel de plateforme.** D4 est amendé
/// le 08/09/2026 : le schéma « référentiel + copie masquante » se contredisait
/// — une société qui ne peut pas écrire ne peut pas créer de copie — et « la
/// copie masque l'original » suppose une règle de SÉLECTION que RLS ne sait pas
/// porter. Quatrième fois que ce dépôt tranche dans ce sens, après les zones,
/// les rôles de contact et les habilitations : *une nomenclature partagée fige
/// un territoire dans un produit destiné à être vendu ailleurs.*
model FamilleMateriel {
  id         String @id @db.Uuid
  societe_id String @db.Uuid

  /// Code court, unique dans la société.
  code    String
  libelle String

  /// ── L'ASSUJETTISSEMENT AUX VGP (L9-03 à L9-05, D88) ──────────────────────
  ///
  /// Il se déclare à la FAMILLE et se propage : c'est le niveau où la question
  /// a un sens réglementaire. **Naissance à `a_determiner`**, sans qu'on l'ait
  /// demandé — le défaut porte la règle, il ne la contourne pas.
  assujettissement_vgp AssujettissementVgp @default(a_determiner)

  /// LA PÉRIODICITÉ EN MOIS, et **AUCUNE VALEUR PAR DÉFAUT** (L9-05, §8).
  /// Elle dépend du matériel et du texte applicable ; la Nouvelle-Calédonie a
  /// son propre code du travail, et la solution sera vendue ailleurs. Une
  /// contrainte de base la rend obligatoire dès que l'assujettissement vaut
  /// `soumis` — jamais un `DEFAULT`, qui serait un délai inventé.
  vgp_periodicite_mois Int?

  /// LA RÉFÉRENCE DU TEXTE QUI FONDE LA PÉRIODICITÉ (L9-04).
  /// *Sans le texte, la périodicité est un chiffre que personne ne peut
  /// défendre.* Obligatoire avec `soumis`, par la même contrainte.
  vgp_reference_texte String?

  actif Boolean @default(true)

  societe       Societe          @relation(fields: [societe_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  modeles       ModeleMateriel[]
  forfaits      Forfait[]
  prestations   Prestation[]
  campagnes_vgp VgpCampagne[]

  /// Cible du chaînage composite de `modele_materiel` : elle rend le couple
  /// (société, famille) référençable d'un seul geste, de sorte qu'un modèle ne
  /// puisse pas désigner la famille d'une AUTRE société.
  @@unique([societe_id, id])
  @@unique([societe_id, code])
  @@map("famille_materiel")
}

/// Modèle de matériel suivi par une société (ticket L1-05).
///
/// Chez CODIMA les modèles viennent du fichier de suivi — équipement, marque,
/// modèle, numéro de série — et non d'un catalogue d'éditeur : **ce sont des
/// données saisies, pas un référentiel reçu.** Le catalogue de plateforme, s'il
/// existe un jour, sera un AMORÇAGE, comme la liste réglementaire des
/// habilitations.
model ModeleMateriel {
  id         String @id @db.Uuid
  societe_id String @db.Uuid
  famille_id String @db.Uuid

  marque    String
  reference String

  /// Caractéristiques libres (chapitre 11). Leur contenu n'est fixé par
  /// personne : ce n'est pas au modèle de données de l'inventer.
  caracteristiques Json?

  /// NULLES quand la maintenance n'est pas périodique. Aucune valeur par
  /// défaut : une périodicité est une décision d'exploitation (CLAUDE.md §8).
  periodicite_jours    Int?
  periodicite_compteur Int?

  /// ── LA PRÉCISION DU MODÈLE (L9-06) ───────────────────────────────────────
  ///
  /// *Les caractéristiques techniques vivent ici, donc c'est ici que préciser a
  /// un sens.* NULLE, le modèle suit sa famille : l'absence n'est pas « aucune
  /// périodicité », c'est « rien à préciser ». Une contrainte exige la
  /// référence du texte avec la périodicité, comme au niveau de la famille —
  /// un chiffre sans son texte ne se défend pas davantage ici.
  vgp_periodicite_mois Int?
  vgp_reference_texte  String?

  actif Boolean @default(true)

  societe  Societe         @relation(fields: [societe_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  famille  FamilleMateriel @relation(fields: [societe_id, famille_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)
  machines Machine[]

  /// La documentation COMMUNE à tous les exemplaires — notice, fiche technique,
  /// manuel d'atelier (L8-01). Elle se corrige une fois pour toutes : c'est ce
  /// qui évite de dupliquer un PDF sur cinq cents machines et de ne jamais
  /// pouvoir le corriger.
  documents Document[]

  /// Cible du chaînage composite que `machine` posera à son tour (L2-01).
  @@unique([societe_id, id])
  @@unique([societe_id, marque, reference])
  @@index([societe_id, famille_id])
  @@map("modele_materiel")
}

model Habilitation {
  id         String @id @db.Uuid
  societe_id String @db.Uuid

  /// Code court, unique dans la société — « B1V », « CACES R489-3 ».
  code    String
  libelle String

  /// Durée de validité en mois, NULLE quand l'habilitation n'expire pas.
  /// Elle ne CALCULE rien : c'est une aide à la saisie, la date d'expiration
  /// étant portée par chaque instance. Deux sources d'un même fait divergent en
  /// silence — ici la seule qui décide est `technicien_habilitation`.
  duree_validite_mois Int?

  actif Boolean @default(true)

  societe Societe @relation(fields: [societe_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  techniciens TechnicienHabilitation[]
  sites       SiteHabilitationRequise[]

  /// Cible des chaînages composites : elle rend le couple (société,
  /// habilitation) référençable d'un seul geste, de sorte qu'une exigence de
  /// site ou une habilitation de technicien ne puisse pas désigner
  /// l'habilitation d'une AUTRE société — les contrôles d'intégrité
  /// référentielle contournant les politiques RLS par construction.
  @@unique([societe_id, id])
  @@unique([societe_id, code])
  @@map("habilitation")
}

/// L'habilitation D'UN technicien, datée (D9, ticket L1-04).
///
/// **Elle se rattache à `utilisateur_societe`, jamais à `utilisateur` seul.**
/// Une habilitation est tenue par une personne EN TANT QUE salarié d'une
/// société ; le chaînage composite `(utilisateur_id, societe_id)` garantit
/// déclarativement qu'on ne peut pas habiliter quelqu'un qui n'appartient pas à
/// la société — c'est la leçon de D48, une contrainte posée sur ce qui la rend
/// vraie plutôt que sur une recopie.
///
/// **UNE ligne par couple, et l'historique vit au journal d'audit.** Un
/// renouvellement met à jour les dates ; I8 en conserve les valeurs avant/après.
/// Garder une ligne par renouvellement aurait donné deux sources au même fait —
/// « quelle est l'habilitation courante » — et obligé chaque lecture à choisir.
model TechnicienHabilitation {
  id              String @id @db.Uuid
  societe_id      String @db.Uuid
  utilisateur_id  String @db.Uuid
  habilitation_id String @db.Uuid

  date_obtention  DateTime  @db.Date
  /// NULLE quand l'habilitation n'expire pas. **`NULL` ne veut pas dire
  /// « expirée »** : RG-PLA-04 compare une date à la date d'intervention, et une
  /// habilitation sans échéance n'est jamais en retard.
  date_expiration DateTime? @db.Date

  societe      Societe            @relation(fields: [societe_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// `Restrict` des deux côtés : retirer quelqu'un d'une société alors qu'il y
  /// porte des habilitations est refusé — c'est une décision d'exploitation, pas
  /// un effet de bord (D49 : une action référentielle est une règle de gestion
  /// déguisée en modalité technique).
  technicien   UtilisateurSociete @relation(fields: [utilisateur_id, societe_id], references: [utilisateur_id, societe_id], onDelete: Restrict, onUpdate: Restrict)
  habilitation Habilitation       @relation(fields: [societe_id, habilitation_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([societe_id, utilisateur_id, habilitation_id])
  @@index([societe_id, utilisateur_id])
  @@map("technicien_habilitation")
}

/// UN BLOCAGE D'AGENDA — la période où quelqu'un n'est pas disponible
/// (L3-04, R3-14, RG-PLA-06).
///
/// > *« Une absence validée bloque le créneau ; les interventions posées
/// > repassent en file à planifier avec alerte. »*
///
/// ## CE QUE CETTE TABLE N'EST PAS, ET C'EST LE SUJET DU 14/09/2026
///
/// **CODIPLAN n'est pas un outil de gestion des ressources humaines.** Elle ne
/// porte donc ni nature, ni motif, ni champ libre, ni historique de statut :
/// *une personne, une date de début, une date de fin, et rien d'autre.* Ce qui
/// a été retiré ce jour-là est écrit, plutôt que tu :
///
/// | Retiré | Pourquoi |
/// |---|---|
/// | `motif` et le type `MotifAbsence` | `arret` est un arrêt de travail : une **donnée de santé**, sur un salarié nommé, en clair. La forme « interne » (D94) la protège du portail ; elle ne protège de rien à l'intérieur. |
/// | `precision` | Le champ libre écrivait la même donnée sans l'énumérer — *un texte libre n'est pas moins nominatif qu'une énumération, il est seulement moins facile à mesurer.* |
/// | `statut` et le type `StatutAbsence` | Un cycle demandée → validée → refusée est un **circuit d'approbation de congés**, c'est-à-dire l'outil RH lui-même. |
///
/// **Le blocage est donc IMMÉDIAT** : une ligne existe, l'agenda est bloqué.
/// *Il n'y a plus de moitié qui ne bloque pas encore*, et c'est ce qui permet
/// aux deux lecteurs — le dénominateur du taux d'occupation et le verrou de
/// chevauchement — de ne lire qu'une période au lieu d'une période et d'un état.
///
/// **Le coût, nommé** : plus rien ne distingue une indisponibilité pressentie
/// d'une indisponibilité arrêtée. Qui pose la ligne l'arrête ; qui se trompe la
/// supprime. *Réouverture : le jour où une indisponibilité doit être proposée
/// avant d'être opposable à un client.*
///
/// ## Sa forme de politique est « INTERNE », et c'est décidé à sa NAISSANCE
///
/// D94 a créé cette forme pour `document_recu` et a écrit ce qu'il laissait
/// ouvert — *le jour où un écran de portail lit une table de forme « société »,
/// la question vise la CLASSE*. **Ici la question ne se pose pas au réveil :
/// elle se pose au moment où la table est créée**, c'est-à-dire au seul moment
/// où elle ne coûte rien (§9, 30/08). Elle le reste après R3-14 : *savoir que
/// telle personne n'est pas là du 14 au 28 reste une information sur une
/// personne nommée, même dépouillée de sa cause.*
///
/// ## Deux dates, bornes COMPRISES, et aucune heure
///
/// Un blocage à la demi-journée n'est pas tranché, donc pas construit — *une
/// colonne inerte n'est pas neutre, elle est une invitation* (D77). La borne
/// fermée est écrite plutôt que laissée à la lecture : « au 28 » veut dire que
/// le 28 est bloqué, et une borne ouverte aurait fait travailler quelqu'un le
/// dernier jour de son indisponibilité.
model Absence {
  id             String @id @default(uuid()) @db.Uuid
  societe_id     String @db.Uuid
  utilisateur_id String @db.Uuid

  /// Première journée bloquée, COMPRISE.
  du DateTime @db.Date
  /// Dernière journée bloquée, COMPRISE.
  au DateTime @db.Date

  cree_le    DateTime @default(now()) @db.Timestamptz(3)
  modifie_le DateTime @updatedAt @db.Timestamptz(3)

  societe    Societe            @relation(fields: [societe_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// **Vers `utilisateur_societe`, jamais vers `utilisateur` seul** : on est
  /// indisponible dans une société, et le chaînage composite garantit
  /// déclarativement qu'on n'inscrit pas le blocage de quelqu'un qui n'y
  /// appartient pas (D48).
  technicien UtilisateurSociete @relation(fields: [utilisateur_id, societe_id], references: [utilisateur_id, societe_id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([societe_id, id])
  @@index([societe_id, utilisateur_id, du, au])
  @@map("absence")
}

/// UN SEGMENT DE TRAVAIL — ce que le compteur du technicien a réellement mesuré
/// (R5-02, L3-08).
///
/// **Le compteur fait foi pour le temps** *(décision d'exploitation du
/// 15/09/2026, D119)*. Ce que cette table porte n'est donc pas une saisie : ce
/// sont des FAITS datés, et le total facturé s'en déduit — arrondi au quart
/// d'heure supérieur puis plancher d'une heure, une seule fois sur
/// l'intervention entière (RG-TAR-05, D83, D89).
///
/// **DES SEGMENTS, ET JAMAIS UN SEUL COUPLE DÉBUT/FIN.** *Une pause est un
/// fait, et un compteur qui ne garde que le total ne peut pas dire ce qui
/// s'est passé entre-temps.* Un technicien qui démarre à 8 h, s'interrompt à
/// 10 h et reprend à 14 h a travaillé quatre heures ; un couple unique en
/// dirait six, et personne ne saurait lesquelles.
///
/// **L'ARRONDI N'EST PAS ICI, ET C'EST DÉLIBÉRÉ.** Cette table stocke des
/// instants ; la valorisation arrondit. *Arrondir à l'écriture ferait deux
/// lectures d'un même critère* (§9, 01/09) — et la seconde serait celle qui
/// décide du prix, sans que le premier arrondi laisse de trace.
///
/// **Table métier de la première catégorie de I1, forme « INTERNE »** (D94) :
/// société ET `app.client_id` absent. Aucun compte de portail ne la lit —
/// *combien de temps une personne nommée a passé chez un client, minute par
/// minute, est une information sur cette personne*, et ce n'est pas ce qu'un
/// bon d'intervention montre. Ce qu'un client a le droit de savoir est le temps
/// FACTURÉ de SON intervention, qui se lit sur l'intervention. Décidé à la
/// NAISSANCE de la table, le seul moment où cela ne coûte rien.
model SegmentTravail {
  /// UUID v7 **fabriqué sur l'appareil** (I10), comme les relevés de compteur :
  /// un segment naît là où le travail a lieu, et il doit pouvoir naître sans
  /// réseau le jour où la file de synchronisation existera.
  id              String @id @db.Uuid
  societe_id      String @db.Uuid
  intervention_id String @db.Uuid
  /// QUI a travaillé. Ce n'est pas forcément `intervention.technicien_id` : un
  /// renfort d'une heure est un fait, et l'affectation n'en dit rien.
  utilisateur_id  String @db.Uuid

  /// L'instant où le compteur a été lancé — **l'heure du TERRAIN, pas celle de
  /// l'arrivée en base** (L2-03) : *l'ordre d'arrivée n'est pas l'ordre des
  /// faits*, et un segment saisi hors réseau arrive après un segment plus
  /// récent. `cree_le` dit quand la ligne est arrivée ; `debut` dit quand le
  /// travail a commencé.
  debut DateTime  @db.Timestamptz(3)
  /// L'instant où il a été arrêté. **`NULL` veut dire « il tourne encore »** —
  /// jamais « on ne sait pas » : la base n'autorise qu'UN segment ouvert par
  /// personne, ce qui rend cet état non ambigu.
  fin   DateTime? @db.Timestamptz(3)

  cree_le    DateTime @default(now()) @db.Timestamptz(3)
  modifie_le DateTime @updatedAt @db.Timestamptz(3)

  societe      Societe            @relation(fields: [societe_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  intervention Intervention       @relation(fields: [societe_id, intervention_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)
  /// **Vers `utilisateur_societe`, jamais vers `utilisateur` seul** — la
  /// quatrième catégorie de I1 ne porte pas de `societe_id`, et une relation
  /// vers elle est refusée par le gardien de D39. C'est la forme d'`absence`
  /// et de `technicien_habilitation`.
  auteur       UtilisateurSociete @relation(fields: [utilisateur_id, societe_id], references: [utilisateur_id, societe_id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([societe_id, id])
  @@index([societe_id, intervention_id, debut])
  @@index([societe_id, utilisateur_id, debut])
  @@map("segment_travail")
}

/// LE TEMPS DE TRAJET PAR ZONE — le DÉFAUT de D23, chiffré par D107 (R3-03).
///
/// RG-PLA-05 pose une cascade : *la valeur saisie sur le site fait foi ;
/// l'estimation par zone n'est qu'un défaut appliqué en son absence.* Les six
/// durées de cette estimation n'étaient écrites nulle part — mesuré à L3-05 —,
/// et D107 les a arrêtées. Cette table porte ce qu'une SOCIÉTÉ en corrige.
///
/// **Elle ne remplace pas le défaut, elle le SURCHARGE.** Une société sans
/// aucune ligne ici reçoit les valeurs de D107, et retirer une ligne rend la
/// main au défaut — *jamais à zéro, qui se lirait « l'agence est sur place »*.
/// C'est pourquoi il n'y a ni ligne obligatoire ni valeur par défaut en base :
/// « non réglé » doit rester un état représentable, exactement comme « société
/// sans charte » l'est pour les couleurs de L0-09.
///
/// **Le point de départ est l'AGENCE, jamais un autre site** (D56, D107) : ces
/// durées sont des trajets ALLER depuis l'agence dont le site dépend. Rien ici
/// ne dit ce que coûte un déplacement d'un site à un autre — *soustraire deux
/// distances à un point commun n'est pas une distance*, et l'application l'écrit
/// plutôt que de l'approcher.
///
/// **DONNÉE DE PLANIFICATION, ET RIEN D'AUTRE** (D74, D107) : elle sert au
/// calcul de charge et aux tournées, et ne s'ajoute jamais aux heures facturées
/// — le déplacement se facture par forfait de zone (RG-INT-07, RG-TAR-06).
model TempsTrajetZone {
  id         String @id @default(uuid()) @db.Uuid
  societe_id String @db.Uuid

  /// La zone, en TEXTE — l'énumération de D23 n'est pas fermée en base, et
  /// c'est la même décision que pour `site.zone_geo` : ces six valeurs sont la
  /// géographie d'UN territoire, et les figer ferait de la carte de la
  /// Nouvelle-Calédonie une contrainte du produit (§9, 19/08 et 20/08). La
  /// liste est tenue close à l'entrée serveur par `lib/sites/zones.ts`, et
  /// l'ouvrir par société est l'objet de R3-04.
  zone String

  /// Minutes de trajet ALLER depuis l'agence. Strictement positif et borné à
  /// une journée — ce n'est pas une règle de gestion mais la longueur d'un
  /// jour, de la même nature que les bornes de `site.latitude`.
  minutes Int

  cree_le    DateTime @default(now()) @db.Timestamptz(3)
  modifie_le DateTime @updatedAt @db.Timestamptz(3)

  societe Societe @relation(fields: [societe_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// UNE valeur par zone et par société — deux lignes pour la même zone
  /// rendraient indécidable celle qui s'applique.
  @@unique([societe_id, zone])
  @@unique([societe_id, id])
  @@map("temps_trajet_zone")
}

/// L'habilitation EXIGÉE par un site (D9, RG-PLA-04, ticket L1-04).
///
/// **Première table FILLE réelle d'une table du parc**, et donc celle qui
/// appelle la sixième forme de politique — « filiation » —, tranchée à L1-02 et
/// construite ici : *une fille est visible si son parent l'est*. La forme
/// « société » aurait laissé un compte portail restreint au site S1 lire les
/// exigences du site S2 ; la forme « parc » aurait exigé de recopier `client_id`,
/// un rattachement que la clé étrangère tient déjà.
model SiteHabilitationRequise {
  id              String @id @db.Uuid
  societe_id      String @db.Uuid
  site_id         String @db.Uuid
  habilitation_id String @db.Uuid

  /// **Bloquant ou non — c'est tout RG-PLA-04.** Bloquant : l'affectation est
  /// REFUSÉE. Non bloquant : elle produit un avertissement et passe.
  bloquant Boolean @default(true)

  societe      Societe      @relation(fields: [societe_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  site         Site         @relation(fields: [societe_id, site_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)
  habilitation Habilitation @relation(fields: [societe_id, habilitation_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([societe_id, site_id, habilitation_id])
  @@index([societe_id, site_id])
  @@map("site_habilitation_requise")
}

/// LA CLASSE DE VISIBILITÉ D'UN DOCUMENT — deux valeurs, et deux seulement
/// (L8-03).
///
/// **Liste close produite par le SCHÉMA**, comme les statuts d'intervention et
/// à l'inverse des zones géographiques (D23) : ce n'est pas la nomenclature
/// d'un territoire, c'est la question « le client a-t-il le droit de lire ce
/// document », qui se pose de la même façon chez toute société.
///
/// *À cinq valeurs, personne ne classe juste* : une classification que l'on
/// hésite à appliquer est appliquée au hasard, et un document mal classé est
/// pire qu'un document absent.
enum ClasseDocument {
  /// Lisible par le portail — notice, certificat, procès-verbal.
  client
  /// Réservé à la société. La classe RÉTRÉCIT, elle n'ouvre rien (L8-04).
  interne
}

/// LA DOCUMENTATION D'UNE MACHINE, D'UN MODÈLE OU D'UNE INTERVENTION (lot 8,
/// L8-01 à L8-06 ; troisième cible ajoutée au ticket BON-2).
///
/// Table métier de la PREMIÈRE catégorie de I1, de forme « héritage » (D93) :
/// *un document est visible si sa CIBLE l'est, et la classe ne fait que
/// rétrécir.* Aucune clause de société n'est écrite dans sa politique — elle
/// serait une seconde source du même fait ; c'est la clé étrangère composite
/// qui empêche un document de dériver de la société de sa cible.
model Document {
  id         String @id @db.Uuid
  societe_id String @db.Uuid

  /// ── LA CIBLE : LE MODÈLE, LA MACHINE **OU** L'INTERVENTION, JAMAIS DEUX
  /// (L8-01, étendue par BON-2) ──────────────────────────────────────────────
  ///
  /// Trois colonnes nullables et la contrainte NOMMÉE `document_cible_unique`
  /// — `num_nonnulls(modele_id, machine_id, intervention_id) = 1`. **C'est le
  /// SCHÉMA qui l'interdit**, pas une validation applicative : la mesure de
  /// L2-04 reste acquise et ne se refait pas — *une colonne `entite_id` avec
  /// plusieurs clés étrangères est un piège qui a l'air d'un verrou et rend la
  /// table inutilisable.*
  ///
  /// Au MODÈLE : notice, fiche technique, manuel d'atelier. À la MACHINE :
  /// certificat de conformité, procès-verbal de mise en service. À
  /// L'INTERVENTION (BON-2) : les photos prises sur place — avant/après,
  /// preuve d'un état constaté — qui ne concernent ni un modèle ni une
  /// machine en particulier mais LA VISITE elle-même.
  modele_id       String? @db.Uuid
  machine_id      String? @db.Uuid
  intervention_id String? @db.Uuid

  classe ClasseDocument

  libelle       String
  nom_fichier   String
  type_mime     String
  /// Jamais zéro : un fichier vide n'est pas un document.
  taille_octets BigInt

  /// L'empreinte SHA-256 des octets, hexadécimal MINUSCULE (contrainte de
  /// forme en base). C'est elle qui rend la déduplication du bac de réception
  /// possible AVANT le rapprochement (L8-07) : deux fois le même PDF est un
  /// seul document, et le découvrir après le rapprochement fait deux fois le
  /// travail. Indexée et NON unique — un constructeur publie des manuels
  /// communs à une gamme, et une unicité par société interdirait d'accrocher
  /// la même notice à deux modèles.
  empreinte String

  /// OÙ SONT LES OCTETS — une clé d'objet, jamais les octets (L8-05).
  /// **Aucun code ne la remplit aujourd'hui** : le module de stockage n'existe
  /// pas, parce qu'aucun écran ne l'appelle encore.
  objet_cle String

  /// Les deux dates de L8-06, dès le premier jour et **inutilisées** : un
  /// certificat porte une date d'émission et une fin de validité, et le lot 9
  /// s'en servira. *Trois minutes maintenant, une migration douloureuse plus
  /// tard.*
  date_document   DateTime? @db.Date
  date_expiration DateTime? @db.Date

  cree_le    DateTime @default(now())
  modifie_le DateTime @updatedAt

  societe      Societe         @relation(fields: [societe_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  modele       ModeleMateriel? @relation(fields: [societe_id, modele_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)
  machine      Machine?        @relation(fields: [societe_id, machine_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)
  intervention Intervention?   @relation(fields: [societe_id, intervention_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)

  /// Les fichiers du bac qui ont produit cette fiche (L8-07).
  recus             DocumentRecu[]
  verifications_vgp VgpVerification[]

  /// Cible du chaînage composite que `document_recu` pose (L8-07).
  @@unique([societe_id, id])
  @@index([societe_id, modele_id])
  @@index([societe_id, machine_id])
  @@index([societe_id, intervention_id])
  @@index([societe_id, empreinte])
  @@map("document")
}

/// LES TROIS ÉTATS D'UN FICHIER DU BAC (L8-07).
///
/// `a_traiter` est la NAISSANCE : un fichier déposé n'est ni classé ni écarté.
/// Les deux autres sont TERMINAUX et portent chacun leur preuve — une fiche
/// pour l'un, un motif pour l'autre, et la base tient les DEUX SENS.
enum StatutDocumentRecu {
  a_traiter
  classe
  ecarte
}

/// LE BAC DE RÉCEPTION (L8-07, D87, D94).
///
/// Un fichier déposé AVANT tout rapprochement. **Il PROPOSE, il ne classe
/// jamais seul** : *un rapprochement faux accroche la notice d'un compresseur à
/// un pont élévateur, et personne ne le voit avant qu'un technicien suive la
/// mauvaise procédure.* C'est une question de sécurité, pas de qualité de
/// données — et c'est ce qui interdit l'automatisme silencieux.
///
/// Forme de politique « interne » (D94) : société ET `app.client_id` absent. Le
/// bac nomme des FICHIERS, et `notice-KPX-337.pdf` dit qu'un pont élévateur
/// existe quelque part — la fuite exacte que D93 ferme un étage plus haut.
model DocumentRecu {
  id         String @id @db.Uuid
  societe_id String @db.Uuid

  /// L'empreinte SHA-256 des octets. **Unique par société, et c'est la BASE qui
  /// le tient** : une déduplication écrite en code lit puis écrit, et entre les
  /// deux un second dépôt du même fichier passe — or le bac est justement
  /// l'endroit où l'on redépose, un téléversement de plusieurs gigaoctets
  /// depuis Nouméa se coupant et se reprenant.
  ///
  /// Par société et non globalement : deux sociétés qui exploitent le même
  /// matériel déposent légitimement la même notice.
  empreinte String

  nom_fichier   String
  type_mime     String
  taille_octets BigInt

  objet_cle        String
  /// L'aperçu de la PREMIÈRE PAGE — *la couverture porte la marque et le
  /// modèle, l'œil fait le travail, pas la reconnaissance de caractères.*
  /// Nullable, et **aucun code ne la remplit** : le stockage n'a pas d'appelant.
  apercu_objet_cle String?

  statut StatutDocumentRecu @default(a_traiter)

  /// La fiche produite par le classement, et le motif de l'écartement. Chacune
  /// est liée à son état par une ÉQUIVALENCE en base, dans les deux sens : ni
  /// classé sans fiche, ni fiche sans classement ; ni écarté sans motif, ni
  /// motif sans écartement. *Le second sens est celui qu'on oublie.*
  document_id  String? @db.Uuid
  ecarte_motif String?

  recu_le    DateTime @default(now())
  modifie_le DateTime @updatedAt

  societe  Societe   @relation(fields: [societe_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  document Document? @relation(fields: [societe_id, document_id], references: [societe_id, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([societe_id, empreinte])
  @@index([societe_id, statut])
  @@map("document_recu")
}

// ── L'IMPORT EXCEL : LE LOT ET SES LIGNES (ticket L1-08e, I6, D15, D100) ────
//
// **Le lot EXISTE DÈS LE CONTRÔLE**, et ce n'est pas une lecture nouvelle du
// chapitre 11 : il écrit `import_lot.statut ∈ {controle, applique, annule}`
// depuis l'origine. I6 veut qu'un import « produise d'abord un rapport, puis
// attende une validation explicite » — *l'application ne peut appliquer que ce
// que le rapport a MONTRÉ*, et un rapport qui ne vit nulle part entre les deux
// ne fait rien appliquer. Il vit ici.

/// Les trois états d'un lot. `controle` est la NAISSANCE : le rapport a été
/// produit, rien n'a été écrit dans le parc. Les deux autres sont TERMINAUX.
enum StatutImportLot {
  controle
  applique
  annule
}

/// Ce que l'application fera — ou a fait — d'une ligne du fichier.
///
/// **Cinq valeurs, là où le chapitre 11 en écrivait trois.** `gabarit` et
/// `vide` sont venues de L1-08c/d, mesurées sur le fichier réel de
/// l'exploitation : 652 lignes pour 55 codes réels sur l'onglet Clients, et
/// *les ranger sous « rejet » ferait 597 erreurs sur un fichier sain* — la
/// panne par le bruit. Elles sont COMPTÉES et non rejetées.
enum ActionImportLigne {
  creation
  modification
  gabarit
  vide
  rejet
}

/// UN LOT D'IMPORT — le rapport de I6, rendu durable.
///
/// Table métier de la PREMIÈRE catégorie de I1 — `societe_id NOT NULL`, RLS
/// activée et forcée, auditée par défaut (D55). Sa politique est de forme
/// « interne » (D100) : société **ET** `app.client_id` absent.
model ImportLot {
  id         String @id @db.Uuid
  societe_id String @db.Uuid

  /// Le type porté par le marqueur `CODIPLAN-<type>-v<n>` (D31), et la version
  /// que le code a lue. **Ce sont des données du FICHIER**, pas une
  /// énumération du produit : un type inconnu est refusé par la grammaire, il
  /// n'a pas besoin d'être fermé ici.
  type_import    String
  version_modele Int

  /// QUI a importé. **Aucune relation Prisma n'est déclarée**, et c'est le
  /// choix de `journal_audit` repris tel quel : une relation ferait naître son
  /// INVERSE sur `utilisateur`, et *une relation dit autant qu'une colonne* —
  /// le gardien de D39 la refuserait, à bon droit. La clé étrangère existe en
  /// base (`ON DELETE RESTRICT`, `ON UPDATE RESTRICT`) : *effacer une identité
  /// qui a importé effacerait la réponse à « qui a écrit cette machine ».*
  utilisateur_id String @db.Uuid

  nom_fichier String
  /// Où sont les octets du fichier source, quand ils sont conservés. NULLABLE,
  /// et **aucun code ne la remplit** : le stockage d'objets n'a pas d'appelant
  /// (§6). *Une colonne qui attend est écrite comme telle, jamais remplie d'un
  /// chemin fabriqué.*
  objet_cle   String?

  statut StatutImportLot @default(controle)

  /// Les décomptes du rapport, tels qu'il les a RENDUS. Ils sont recopiés ici
  /// pour qu'un lot se relise sans reparcourir ses lignes — et un gardien
  /// vérifie qu'ils s'accordent avec elles, faute de quoi ce serait la
  /// divergence du §9 (01/09) posée en base.
  lignes_creations     Int @default(0)
  lignes_modifications Int @default(0)
  lignes_rejets        Int @default(0)
  lignes_gabarits      Int @default(0)
  lignes_vides         Int @default(0)

  /// AJOUTÉE le 16/09/2026 (session dépassement de délai, point 1) — et elle
  /// N'EST PAS de la même famille que les cinq colonnes ci-dessus : celles-là
  /// sont « tels que le rapport les a RENDUS », posées une fois au contrôle et
  /// jamais réécrites ; celle-ci n'a AUCUNE proposition à trahir — le contrôle
  /// ne peut pas savoir si une ligne classée MODIFICATION ne changera rien,
  /// seule l'APPLICATION le mesure, en comparant chaque fiche avant d'écrire
  /// (`porteEncore`, `lib/imports/application.ts`). Elle vaut donc zéro tant
  /// que le lot reste `controle`, et l'application la pose une seule fois, en
  /// même temps que `statut` et `applique_le`.
  lignes_inchangees Int @default(0)

  controle_le DateTime  @default(now())
  /// Quand les fiches ont été écrites. **Elle SURVIT à l'annulation** : un lot
  /// annulé a bel et bien été appliqué, et effacer cette date perdrait la seule
  /// trace du moment où le parc a changé (L1-08j).
  applique_le DateTime?
  annule_le   DateTime?

  /// AJOUTÉE le 23/09/2026 (MESURE-1) — la durée RÉELLEMENT mesurée de la
  /// transaction d'application, du début du travail jusqu'à son `COMMIT`, en
  /// millisecondes. **CE N'EST PAS `applique_le - controle_le`** : cet écart
  /// contient le temps qu'un humain a passé à lire le rapport avant de
  /// valider — un lot contrôlé à 9h et appliqué à 14h donnerait cinq heures,
  /// pas une durée de transaction. Elle est mesurée par un chronomètre posé
  /// au tout début de la transaction (`process.hrtime.bigint()`,
  /// `lib/imports/application.ts`) et écrite une seule fois, dans la MÊME
  /// écriture que `statut` et `applique_le`.
  ///
  /// NULLABLE, et **jamais zéro** : un lot qui reste `controle` n'a rien à
  /// mesurer et porte l'ABSENCE, jamais zéro — zéro se lirait comme
  /// « instantané », c'est-à-dire un mensonge (une transaction réelle ne dure
  /// jamais zéro milliseconde). Même famille que `lignes_inchangees` sans son
  /// défaut : celle-ci vaut zéro tant que rien ne l'a mesurée, celle-là ne
  /// PEUT pas prendre cette valeur.
  duree_application_ms Int?

  societe Societe          @relation(fields: [societe_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lignes  ImportLotLigne[]

  /// Cible du chaînage composite depuis `import_lot_ligne` : sans la société
  /// DANS la clé, une ligne pourrait s'adosser au lot d'une AUTRE société —
  /// les contrôles d'intégrité référentielle contournent RLS par construction.
  @@unique([societe_id, id])
  @@index([societe_id, statut])
  @@map("import_lot")
}

/// UNE LIGNE DU RAPPORT — ce que l'application appliquera, et ce que
/// l'annulation restaurera.
///
/// Même catégorie et même forme que son lot (D100). **Et c'est elle qui a
/// décidé de la forme** : elle porte la ligne du fichier telle qu'elle a été
/// lue, c'est-à-dire le parc entier de la société, qu'aucun périmètre de sites
/// n'a jamais filtré.
model ImportLotLigne {
  id            String @id @db.Uuid
  societe_id    String @db.Uuid
  import_lot_id String @db.Uuid

  /// Le rang tel qu'un humain le lit dans le tableur (1 = première ligne).
  rang   Int
  action ActionImportLigne

  /// Ce que la ligne DÉSIGNE. Absente pour un gabarit et pour une ligne vide :
  /// *ils ne désignent rien, et leur inventer une clé les ferait entrer dans
  /// l'espace des clés réelles, où deux lignes muettes deviendraient la même
  /// machine* (L1-08c).
  cle      String?
  /// La clé est-elle COMPLÈTE — un vrai numéro de série — ou reconstituée ?
  complete Boolean?

  /// L'entité visée et son identifiant, quand l'application a écrit.
  entite    String?
  entite_id String? @db.Uuid

  /// Le motif du rejet. Lié à l'action par une ÉQUIVALENCE en base, dans les
  /// deux sens : ni rejet sans motif, ni motif sans rejet.
  rejet_motif String?

  /// La ligne du fichier, colonne par colonne, telle qu'elle a été lue.
  valeurs Json

  /// **CE QUE D15 EXIGE POUR RESTAURER.** Renseignée par l'APPLICATION quand
  /// elle écrase une fiche existante, jamais par le contrôle : avant
  /// l'application, il n'y a rien à restaurer.
  valeurs_avant Json?

  lot     ImportLot @relation(fields: [societe_id, import_lot_id], references: [societe_id, id], onDelete: Cascade, onUpdate: Restrict)
  societe Societe   @relation(fields: [societe_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([import_lot_id, rang])
  @@index([societe_id, import_lot_id])
  @@map("import_lot_ligne")
}
